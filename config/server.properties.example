# YaPcore — copy to config/server.properties (gitignored) and edit
#
# Sensible defaults for local/LAN. See docs/QUICK_START.md for production profile.

server-name=YaPcore
motd=YaPcore · Folia Game · Yap Edge
port=25566
bind-host=0.0.0.0
max-players=300
ram-mb=2048
ram-min-mb=512
view-distance=10

# Local/LAN — set online-mode=true before going public
online-mode=false
auto-op=false
ops=
allow-localhost=true
internet-exposed=false

# Public join (leave blank for LAN; set when internet-exposed=true)
server-domain=
public-host=
public-port=0
public-bedrock-port=0
public-pack-port=0

# Editions & crossplay
java-enabled=true
bedrock-enabled=true
shared-listen-port=true
crossplay-enabled=true
backwards-compatible=true

# Game authority (product default)
game-authority=folia
folia-embed=true
folia-dir=folia-kernel
folia-port=25567
folia-version=26.2
# Legacy BukkitScheduler → Folia region schedulers (yap-sched-agent)
folia-sched-compat=true
folia-sched-compat-warn=true
# Cross-region teleport two-phase commit (requires patched yap-folia)
folia-teleport-transactions=true
# folia-jar-source=fetch|build|path|auto
# RECOMMENDED: build (YaP-Folia) after ./scripts/build-yap-folia.sh + soak-compat green
# Default stays fetch until Agent 1 flips post A2 soak — see docs/YAP_FOLIA_SOAK.md
folia-jar-source=fetch
# folia-jar-path=
# folia-jar-url=

# Resource pack (built-in HTTP on :8081)
resource-pack-enabled=true
resource-pack-file=yapcore-default.zip
resource-pack-files=yapcore-default.zip
resource-pack-http-port=8081
resource-pack-public-host=
resource-pack-url=
resource-pack-forced=false
resource-pack-prompt=This server offers a resource pack. Click Yes to download, or No to play without it.

# Web dashboard (token auto-generated on first boot if empty)
web-dashboard-enabled=true
web-dashboard-port=8080
web-dashboard-bind=127.0.0.1
web-dashboard-localhost-only=true
web-dashboard-token=

# Native ranks — auto-apply starter pack ~8s after first boot
yap-ranks-auto-apply=true

# GUI
gui-enabled=true

# nginx (optional public edge — see docs/NGINX_AND_LOCALHOST.md)
nginx-domain=
nginx-public-port=25565
nginx-pack-port=80
srv-enabled=true
srv-priority=0
srv-weight=5

# Proxy (optional multi-backend)
velocity-enabled=false
velocity-online-mode=true

# JVM tuning
jvm-gc=zgc
jvm-numa=true
jvm-heap-pin=true
