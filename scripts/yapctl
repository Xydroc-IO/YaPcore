#!/usr/bin/env bash
# Minimal operator control stub for YaPcore (Phase 5 lite).
# Usage: ./scripts/yapctl start|stop|status|soak-*|cite-fullcite|help
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# shellcheck disable=SC1091
. "$ROOT/scripts/lib.sh"

CMD="${1:-help}"
shift || true

case "$CMD" in
  start)
    exec "$ROOT/scripts/start.sh" "$@"
    ;;
  stop)
    exec "$ROOT/scripts/stop.sh" "$@"
    ;;
  status)
    exec "$ROOT/scripts/status.sh" "$@"
    ;;
  soak-compat|soak)
    exec "$ROOT/scripts/soak-yap-folia.sh" compat "$@"
    ;;
  soak-perf)
    exec "$ROOT/scripts/soak-yap-folia.sh" perf "$@"
    ;;
  soak-long)
    exec "$ROOT/scripts/soak-yap-folia.sh" long "$@"
    ;;
  cite-fullcite|cite)
    exec "$ROOT/scripts/bench/cite-fullcite.sh" "$@"
    ;;
  build-folia)
    exec "$ROOT/scripts/build-yap-folia.sh" "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
yapctl — thin wrapper over YaPcore scripts

  yapctl start [--fg]     → scripts/start.sh
  yapctl stop             → scripts/stop.sh
  yapctl status           → scripts/status.sh
  yapctl build-folia      → scripts/build-yap-folia.sh
  yapctl soak-compat      → scripts/soak-yap-folia.sh compat
  yapctl soak-perf [min]  → short heap soak (default 30m)
  yapctl soak-long [hrs]  → 12h default slope soak (8h floor)
  yapctl cite-fullcite    → stock Folia vs YaPcore fullcite MSPT (cite gate)

Uptime: 12h continuous flat heap/threads (8h floor). Restarts = ops hygiene.
Cite: yapctl cite-fullcite → bench/results/cite-latest-*.json
EOF
    ;;
  *)
    echo "Unknown command: $CMD (try: yapctl help)" >&2
    exit 2
    ;;
esac
