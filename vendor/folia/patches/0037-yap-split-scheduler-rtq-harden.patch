+        private static void requeueOrphan(final ChunkBasedPriorityTask task) {
+            final Runnable run = task.run;
+            task.run = null;
+            if (run == null) {
+                return;
+            }
+            YapRegionSplit.markSplit();
+            Priority prio = task.getPriority();
+            if (prio == null || prio == Priority.COMPLETING) {
+                prio = Priority.NORMAL;
+            }
+            final ServerLevel world = task.world.world;
+            if (task.isChunkTask) {
+                RegionizedServer.getInstance().taskQueue.queueChunkTask(world, task.chunkX, task.chunkZ, run, prio);
+            } else {
+                RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(world, task.chunkX, task.chunkZ, run, prio);
+            }
+        }
+
