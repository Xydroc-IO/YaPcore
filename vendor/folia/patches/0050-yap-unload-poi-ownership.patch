     public static final boolean LOAD_FOR_SEARCHING = true;
 
+    /**
+     * Folia: {@link PoiManager#get} / {@link PoiManager#getOrLoad} both
+     * {@code ensureTickThread}. After a regionizer split, villager SCAN_RANGE can
+     * include neighbour-region or cut chunks. Skip those sections — do not disable
+     * village AI, just stay on the owning region.
+     */
+    private static boolean ownedByCurrentRegion(final PoiManager poiStorage, final int chunkX, final int chunkZ) {
+        if (!(poiStorage.levelHeightAccessor instanceof net.minecraft.server.level.ServerLevel world)) {
+            return true;
+        }
+        return ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, chunkX, chunkZ);
+    }
