From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP idempotent regionizer remove + on-thread POI search

Corridor unload can repairRegionizer then Moonrise onChunkHolderDelete the
same key; removeChunk must no-op if the bit is already clear. Villager
AcquirePoi SCAN_RANGE can hit a neighbour-region POI chunk after split —
skip those sections instead of ensureTickThread. Carve/partition/async stay
on. Post-applyAllPatches.
---

--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/ThreadedRegionizer.java
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/ThreadedRegionizer.java
@@ -474,8 +474,10 @@
         // Given that for each section, no addChunk/removeChunk can occur in parallel,
         // we can avoid the lock IF the section exists AND it has a chunk count > 1
         final ThreadedRegionSection<R, S> section = this.sections.get(sectionKey);
-        if (section == null) {
-            throw new IllegalStateException("Chunk (" + chunkX + "," + chunkZ + ") has no section");
+        if (section == null || !section.containsChunk(chunkX, chunkZ)) {
+            // YaP corridor unload can repairRegionizer then Moonrise onChunkHolderDelete
+            // the same key; double-remove must not kill the region thread.
+            return;
         }
         if (!section.hasOnlyOneChunk()) {
             // chunk will not go empty, so we don't need to acquire the lock
@@ -1266,6 +1268,11 @@
             return this.chunkCount == 1;
         }
 
+        private boolean containsChunk(final int chunkX, final int chunkZ) {
+            final int index = this.getChunkIndex(chunkX, chunkZ);
+            return (this.chunksBitset[index >>> 6] & (1L << (index & (Long.SIZE - 1)))) != 0;
+        }
+
         public boolean hasNonEmptyNeighbours() {
             return this.nonEmptyNeighbours != 0;
         }
@@ -1342,7 +1349,8 @@
             final long before = this.chunksBitset[index >>> 6]; // index / Long.SIZE
             final long bitset = this.chunksBitset[index >>> 6] = before & ~(1L << (index & (Long.SIZE - 1)));
             if (before == bitset) {
-                throw new IllegalStateException("Cannot remove a chunk from a section which does not have that chunk! RegionSection: " + this + ", global chunk: " + new ChunkPos(chunkX, chunkZ).toString());
+                // Already absent (holder-delete after repair). Do not decrement chunkCount/neighbours.
+                return false;
             }
             final boolean empty = --this.chunkCount == 0;
             if (empty && this.nonEmptyNeighbours == 0) {
