+    /**
+     * Prefer a cut index near {@code preferred} where the section just before or at the cut is empty.
+     * Always returns in {@code [1, size-1]} so both sides are non-empty lists when size >= 2.
+     */
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    int preferEmptyCut(final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted, final int preferred) {
+        final int size = sorted.size();
+        if (size < 2) {
+            return Math.max(1, preferred);
+        }
+        final int lo = 1;
+        final int hi = size - 1;
+        final int start = Math.min(hi, Math.max(lo, preferred));
+        // Search outward from preferred for an empty-sided cut
+        for (int d = 0; d < size; ++d) {
+            final int left = start - d;
+            final int right = start + d;
+            if (left >= lo && left <= hi && isEmptySidedCut(sorted, left)) {
+                return left;
+            }
+            if (d != 0 && right >= lo && right <= hi && isEmptySidedCut(sorted, right)) {
+                return right;
+            }
+        }
+        return start;
+    }
+
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    boolean isEmptySidedCut(final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted, final int cut) {
+        // cut splits [0, cut) | [cut, size); prefer empty on either side of the boundary
+        return sorted.get(cut - 1).isEmpty() || sorted.get(cut).isEmpty();
+    }
+
