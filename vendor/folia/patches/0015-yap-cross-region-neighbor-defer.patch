     private void addAndRun(final BlockPos pos, final CollectingNeighborUpdater.NeighborUpdates update) {
+        // YaP / Folia — if the target block is owned by another region (force-partition shard
+        // borders), defer onto that region's tick queue instead of crashing. Matches how Folia
+        // already routes cross-region setblock/POI work via RegionizedTaskQueue.
+        if (this.level instanceof net.minecraft.server.level.ServerLevel serverLevel
+                && !ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this.level, pos)) {
+            if (serverLevel.getChunkIfLoaded(pos) == null) {
+                return; // unloaded — same semantics as patch 0004 skip
+            }
+            final BlockPos immutable = pos.immutable();
+            io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+                    serverLevel,
+                    immutable.getX() >> 4,
+                    immutable.getZ() >> 4,
+                    () -> {
+                        final CollectingNeighborUpdater owning =
+                                serverLevel.getCurrentWorldData().neighborUpdater;
+                        owning.addAndRunOwned(immutable, update);
+                    }
+            );
+            return;
+        }
+        this.addAndRunOwned(pos, update);
+    }
+
+    private void addAndRunOwned(final BlockPos pos, final CollectingNeighborUpdater.NeighborUpdates update) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread(this.level, pos, "Adding block without owning region"); // Folia - region threading
         boolean runningAlready = this.count > 0;
         boolean tooManyUpdates = this.maxChainedNeighborUpdates >= 0 && this.count >= this.maxChainedNeighborUpdates;

