+    /**
+     * Partner may already be on the EDF queue (race with the normal scheduler).
+     * Never let {@link IllegalStateException} escape — it takes down the region thread.
+     */
+    private static void trySchedulePartner(final TickRegionScheduler scheduler,
+                                           final TickRegionScheduler.RegionScheduleHandle partner) {
+        try {
+            scheduler.scheduleRegion(partner);
+        } catch (final IllegalStateException already) {
+            LOGGER.debug("YaP portal couple: partner already scheduled/cancelled", already);
+        } catch (final Throwable t) {
+            LOGGER.warn("YaP portal couple: failed to reschedule partner", t);
+        }
+    }
