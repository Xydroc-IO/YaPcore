+    static void stripPortalKeys(final ServerLevel world, final LongOpenHashSet keys) {
+        if (world == null || keys == null || keys.isEmpty()) {
+            return;
+        }
+        final LongOpenHashSet drop = new LongOpenHashSet();
+        final LongIterator it = keys.iterator();
+        while (it.hasNext()) {
+            final long chunkKey = it.nextLong();
+            if (hasDimensionPortal(world, CoordinateUtils.getChunkX(chunkKey), CoordinateUtils.getChunkZ(chunkKey))) {
+                drop.add(chunkKey);
+            }
+        }
+        keys.removeAll(drop);
+    }
+
+    static boolean hasDimensionPortal(final ServerLevel world, final int chunkX, final int chunkZ) {
+        if (world == null) {
+            return false;
+        }
+        try {
+            final net.minecraft.world.level.chunk.LevelChunk chunk = world.getChunkIfLoaded(chunkX, chunkZ);
+            if (chunk == null) {
+                return false;
+            }
+            for (final net.minecraft.world.level.chunk.LevelChunkSection section : chunk.getSections()) {
+                if (section == null || section.hasOnlyAir()) {
+                    continue;
+                }
+                if (section.maybeHas(state ->
+                        state.is(net.minecraft.world.level.block.Blocks.NETHER_PORTAL)
+                                || state.is(net.minecraft.world.level.block.Blocks.END_PORTAL)
+                                || state.is(net.minecraft.world.level.block.Blocks.END_GATEWAY))) {
+                    return true;
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+        return false;
+    }
