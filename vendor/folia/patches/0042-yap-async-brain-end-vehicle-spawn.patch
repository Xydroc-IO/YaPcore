+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapAsyncTeleport.java
@@ -0,0 +1,35 @@
+package io.papermc.paper.threadedregions;
+
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Thread-local destination while {@code Entity.transformForAsyncTeleport} copies
+ * an entity on the origin region thread. Brain / {@code getCurrentWorldData}
+ * must not observe the dest world until {@code placeInAsync} on the dest thread.
+ *
+ * <p>Folia #446 / #457: villager {@code updateActivityFromSchedule} during
+ * {@code EntityType.create(DIMENSION_TRAVEL)} throws World mismatch.
+ */
+public final class YapAsyncTeleport {
+
+    private static final ThreadLocal<ServerLevel> DEST = new ThreadLocal<>();
+
+    private YapAsyncTeleport() {
+    }
+
+    public static void enter(final ServerLevel destination) {
+        DEST.set(destination);
+    }
+
+    public static void leave() {
+        DEST.remove();
+    }
+
+    public static boolean inTransform() {
+        return DEST.get() != null;
+    }
+
+    public static ServerLevel destination() {
+        return DEST.get();
+    }
+}
