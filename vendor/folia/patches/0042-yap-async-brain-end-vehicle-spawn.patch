+    /** Folia #453: vehicle/end return uses the riding player's respawn, not world spawn. */
+    public static void applyEndOverworldExit(final Entity entity, final ServerLevel destination, final Dest dest) {
+        dest.world = destination;
+        dest.yaw = entity.getYRot();
+        dest.pitch = entity.getXRot();
+        dest.pos = Vec3.atBottomCenterOf(destination.getRespawnData().pos());
+        final ServerPlayer player = playerInTree(entity);
+        if (player == null) {
+            return;
+        }
+        final ServerPlayer.RespawnConfig cfg = player.getRespawnConfig();
+        if (cfg == null) {
+            return;
+        }
+        if (cfg.respawnData().dimension() != destination.dimension()) {
+            return;
+        }
+        dest.pos = Vec3.atBottomCenterOf(cfg.respawnData().pos());
+        dest.yaw = cfg.respawnData().yaw();
+        dest.pitch = cfg.respawnData().pitch();
+    }
+
+    private static ServerPlayer playerInTree(final Entity root) {
+        if (root instanceof ServerPlayer player) {
+            return player;
+        }
+        for (final Entity passenger : root.getIndirectPassengers()) {
+            if (passenger instanceof ServerPlayer player) {
+                return player;
+            }
+        }
+        return null;
+    }
+
