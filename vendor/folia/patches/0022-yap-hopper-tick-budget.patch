+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * YaP — per-region hopper tick budget for hopper-heavy loads (fullcite / heavypop).
+ *
+ * <p>{@code -Dyap.folia.hopper-tick-budget=N} — max hopper {@code pushItemsTick}
+ * calls that may transfer this region tick ({@code 0} = off).
+ *
+ * <p>Over-budget hoppers still decrement cooldown but skip {@code tryMoveItems}
+ * for this tick (soft deferral). TNT / players are unaffected.
+ */
+public final class YapHopperTickBudget {
+
+    private static final ThreadLocal<Counter> CURRENT = new ThreadLocal<>();
+    private static final AtomicLong SKIPPED = new AtomicLong();
+
+    private YapHopperTickBudget() {
+    }
+
+    public static int budget() {
+        return Integer.getInteger("yap.folia.hopper-tick-budget", 0);
+    }
+
+    public static boolean enabled() {
+        return budget() > 0;
+    }
+
+    public static void beginTick() {
+        if (!enabled()) {
+            return;
+        }
+        Counter c = CURRENT.get();
+        if (c == null) {
+            c = new Counter();
+            CURRENT.set(c);
+        }
+        c.ticked = 0;
+        c.limit = budget();
+    }
+
+    public static void endTick() {
+        CURRENT.remove();
+    }
+
+    /** @return true if this hopper may run item transfer this tick */
+    public static boolean allowTick() {
+        if (!enabled()) {
+            return true;
+        }
+        final Counter c = CURRENT.get();
+        if (c == null) {
+            return true;
+        }
+        if (c.ticked >= c.limit) {
+            SKIPPED.incrementAndGet();
+            return false;
+        }
+        c.ticked++;
+        return true;
+    }
+
+    public static long skippedCount() {
+        return SKIPPED.get();
+    }
+
+    private static final class Counter {
+        int ticked;
+        int limit;
+    }
+}
