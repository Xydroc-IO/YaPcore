+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import net.minecraft.server.level.ServerLevel;
+
+import java.io.IOException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+/**
+ * YaP Phase 3.3 — offload blocking Moonrise region-file flush from region/tick threads.
+ *
+ * <p>Gated by {@code -Dyap.folia.async-chunk-save=true} (default false).
+ */
+public final class YapAsyncChunkSave {
+
+    private static final Logger LOG = Logger.getLogger("YaP.AsyncChunkSave");
+    private static final AtomicInteger THREAD_SEQ = new AtomicInteger();
+    private static final ExecutorService IO = Executors.newFixedThreadPool(
+            Math.max(1, Integer.getInteger("yap.folia.async-chunk-save.threads", 2)),
+            (ThreadFactory) r -> {
+                Thread t = new Thread(r, "yap-async-chunk-save-" + THREAD_SEQ.incrementAndGet());
+                t.setDaemon(true);
+                return t;
+            });
+
+    private YapAsyncChunkSave() {
+    }
+
+    public static boolean enabled() {
+        return Boolean.parseBoolean(System.getProperty("yap.folia.async-chunk-save", "false"));
+    }
+
+    /**
+     * When enabled, enqueue flush work and return immediately; otherwise run {@code sync} on caller.
+     */
+    public static void flushOrEnqueue(final ServerLevel world, final Runnable sync) {
+        if (!enabled()) {
+            sync.run();
+            return;
+        }
+        IO.execute(() -> {
+            try {
+                sync.run();
+            } catch (final Throwable t) {
+                LOG.log(Level.SEVERE, "Async chunk flush failed for world '"
+                        + world.getWorld().getName() + "'", t);
+            }
+        });
+    }
+
+    public static void flushWorld(final ServerLevel world) {
+        flushOrEnqueue(world, () -> {
+            MoonriseRegionFileIO.flush(world);
+            try {
+                MoonriseRegionFileIO.flushRegionStorages(world);
+            } catch (final IOException ex) {
+                throw new RuntimeException(ex);
+            }
+        });
+    }
+}
