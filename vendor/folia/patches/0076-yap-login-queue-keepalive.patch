+    public static BlockPos avoidCutColumn(final ServerLevel world, final BlockPos spawn) {
+        final int cz = spawn.getZ() >> 4;
+        int cx = spawn.getX() >> 4;
+        if (!io.papermc.paper.threadedregions.YapRegionizerGap.isCutChunk(world, cx, cz)) {
+            return spawn;
+        }
+        final int shift = io.papermc.paper.threadedregions.TickRegions.getRegionChunkShift();
+        int section = cx >> shift;
+        for (int i = 0; i < 4; ++i) {
+            section++;
+            cx = section << shift;
+            if (!io.papermc.paper.threadedregions.YapRegionizerGap.isCutChunk(world, cx, cz)) {
+                return new BlockPos((cx << 4) + 8, spawn.getY(), spawn.getZ());
+            }
+        }
+        return spawn;
+    }
