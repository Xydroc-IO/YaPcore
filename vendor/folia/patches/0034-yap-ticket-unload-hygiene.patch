From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP Folia ticket/unload hygiene

Last ticket on the owning region thread drops immediately (no UNKNOWN 1-tick).
Scheduler/RTQ/teleport holds are LOADING-only so they do not simulate a radius.
processTicketUpdates runs after hold add/remove so processUnloads can reap same tick.
Post-applyAllPatches.
---

--- /dev/null
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapTicketHygiene.java
@@ -0,0 +1,49 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager;
+import net.minecraft.server.level.ServerLevel;
+
+/**
+ * Folia ticket/unload hygiene. Scheduler and RTQ holds must not leak simulation
+ * radius, and dropping the last ticket on the owning region thread must drop the
+ * ticket level immediately instead of injecting {@code UNKNOWN} for one more tick.
+ *
+ * <p>Region thread: every {@link #deferLevelDrop} call reads the chunk's owning
+ * region via {@link TickThread}. Cross-region removes keep the UNKNOWN delay so
+ * ticket levels do not change while another region is ticking.
+ */
+public final class YapTicketHygiene {
+
+    private static final boolean ENABLED = Boolean.parseBoolean(
+            System.getProperty("yap.folia.ticket-hygiene", "true"));
+
+    private YapTicketHygiene() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    /**
+     * @return {@code true} to keep Moonrise UNKNOWN replacement; {@code false} to
+     * drop the ticket level immediately (last ticket, owning region thread).
+     */
+    public static boolean deferLevelDrop(final ServerLevel world, final int chunkX, final int chunkZ,
+                                         final int newLevel) {
+        if (!ENABLED || world == null) {
+            return true;
+        }
+        if (newLevel <= ChunkHolderManager.MAX_TICKET_LEVEL) {
+            return true;
+        }
+        return !TickThread.isTickThreadFor(world, chunkX, chunkZ);
+    }
+
+    public static void processAfterHoldChange(final ServerLevel world, final int chunkX, final int chunkZ) {
+        if (!ENABLED || world == null) {
+            return;
+        }
+        world.moonrise$getChunkTaskScheduler().chunkHolderManager.processTicketUpdates(chunkX, chunkZ);
+    }
+}
