+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.TicketType;
+import org.slf4j.Logger;
+
+/**
+ * Corridor ticket strip, holder reap, regionizer repair, and gap-band unload.
+ */
+final class YapCorridorUnload {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private YapCorridorUnload() {
+    }
+
+    static void maintainGapBand(final YapCorridorPlanner.GapHold hold) {
+        final LongOpenHashSet keys = YapCorridorPlanner.collectCorridorKeysFromWorld(hold.world, hold.plan);
+        if (keys.isEmpty()) {
+            return;
+        }
+        // Anchor outside corridor — never queueTickTaskQueue on gap chunks (pins them).
+        YapCorridorCarver.runOnAnchor(hold.world, hold.anchor, 30L, () -> {
+            for (final long key : keys) {
+                final int cx = CoordinateUtils.getChunkX(key);
+                final int cz = CoordinateUtils.getChunkZ(key);
+                if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(hold.world, cx, cz)) {
+                    continue;
+                }
+                try {
+                    hold.world.setChunkForced(cx, cz, false);
+                } catch (final Throwable ignored) {
+                }
+                stripNonUnknownTickets(hold.world, cx, cz);
+                maintainGapChunk(hold, cx, cz);
+            }
+            flushCorridorUnloads(hold.world);
+        });
+    }
+
+    /** Strip sim tickets and unload corridor chunks re-pinned after partition — no regionizer.removeChunk. */
+    static void maintainGapChunk(final YapCorridorPlanner.GapHold hold, final int cx, final int cz) {
+        final org.bukkit.World bukkit = hold.world.getWorld();
+        if (hold.landings != null) {
+            YapCorridorEntities.relocateGapEntities(hold, cx, cz);
+        }
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            return;
+        }
+        if (YapCorridorEntities.corridorChunkHasNonPlayerEntities(hold.world, cx, cz)) {
+            return;
+        }
+        stripNonUnknownTickets(hold.world, cx, cz);
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            return;
+        }
+        bukkit.unloadChunkRequest(cx, cz);
+    }
+
+    /**
+     * Evacuate + optionally soft-unload one corridor chunk, or repair regionizer desync if Bukkit already unloaded it.
+     * @param unloadOnly if true, attempt soft unload after relocate (never hard {@code unloadChunk}).
+     */
+    static void carveOneChunk(final ServerLevel world, final long regionId, final int cx, final int cz,
+                              final boolean unloadOnly) {
+        final org.bukkit.World bukkit = world.getWorld();
+
+        // Relocate WHILE chunk is still held (force-loaded / tickets). Unforcing first orphans TNT.
+        if (bukkit.isChunkLoaded(cx, cz)) {
+            YapCorridorEntities.relocateCorridorEntities(world, regionId, cx, cz);
+            if (YapCorridorEntities.corridorChunkHasNonPlayerEntities(world, cx, cz)) {
+                return;
+            }
+        }
+
+        try {
+            world.setChunkForced(cx, cz, false);
+        } catch (final Throwable ignored) {
+        }
+        dropBukkitPins(bukkit, cx, cz);
+
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            if (!unloadOnly) {
+                stripNonUnknownTickets(world, cx, cz);
+            }
+            flushCorridorUnloads(world);
+            repairRegionizer(world, cx, cz);
+            return;
+        }
+
+        stripNonUnknownTickets(world, cx, cz);
+        if (!unloadOnly) {
+            return;
+        }
+        if (YapCorridorEntities.corridorChunkHasNonPlayerEntities(world, cx, cz)) {
+            return;
+        }
+        bukkit.unloadChunkRequest(cx, cz);
+        flushCorridorUnloads(world);
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            repairRegionizer(world, cx, cz);
+            YapCorridorCarver.CHUNKS_UNLOADED.increment();
+        }
+    }
+
+    static void carveOneChunk(final ServerLevel world, final long regionId, final int cx, final int cz) {
