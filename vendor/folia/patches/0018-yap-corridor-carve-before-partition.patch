+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.LongArrayList;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Corridor geometry, remaining-key collection, and landing-pad selection.
+ */
+final class YapCorridorPlanner {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private YapCorridorPlanner() {
+    }
+
+    static LongOpenHashSet collectCorridorKeysFromWorld(final ServerLevel world, final YapCorridorCarver.CorridorPlan plan) {
+        final LongOpenHashSet keys = new LongOpenHashSet();
+        try {
+            world.regioniser.computeForAllRegionsUnsynchronised(region -> {
+                if (region.id != plan.regionId()) {
+                    return;
+                }
+                final List<? extends ThreadedRegionizer.ThreadedRegionSection<?, ?>> sections = region.copySections();
+                for (final ThreadedRegionizer.ThreadedRegionSection<?, ?> s : sections) {
+                    if (s.isEmpty()) {
+                        continue;
+                    }
+                    final int coord = plan.cutOnX() ? s.sectionX : s.sectionZ;
+                    if (coord < plan.lo() || coord > plan.hi()) {
+                        continue;
+                    }
+                    final LongArrayList chunks = s.getChunks();
+                    for (int i = 0; i < chunks.size(); ++i) {
+                        keys.add(chunks.getLong(i));
+                    }
+                }
+            });
+        } catch (final Throwable t) {
+            LOGGER.warn("YaP corridor collect remaining failed", t);
+        }
+        return keys;
+    }
+
+    static final class GapHold {
+        final ServerLevel world;
+        final YapCorridorCarver.CorridorPlan plan;
+        final int[] anchor;
+        final CarveLandings landings;
+        final AtomicInteger tickCounter = new AtomicInteger();
+
+        GapHold(final ServerLevel world, final YapCorridorCarver.CorridorPlan plan, final int[] anchor,
+                final CarveLandings landings) {
+            this.world = world;
+            this.plan = plan;
+            this.anchor = anchor;
+            this.landings = landings;
+        }
+    }
+
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    YapCorridorCarver.CorridorPlan planCorridor(
+            final ThreadedRegionizer.ThreadedRegion<R, S> region,
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final int createRadius) {
+        final int minGap = 2 * createRadius + 1;
+        final int maxChunks = Math.max(64, Integer.getInteger("yap.folia.subregion-carve-max-chunks", 4096));
+
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> left = groups.get(0);
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> right = groups.get(groups.size() - 1);
+        int leftMaxX = Integer.MIN_VALUE, leftMaxZ = Integer.MIN_VALUE;
+        int leftMinX = Integer.MAX_VALUE, leftMinZ = Integer.MAX_VALUE;
+        int rightMinX = Integer.MAX_VALUE, rightMinZ = Integer.MAX_VALUE;
+        int rightMaxX = Integer.MIN_VALUE, rightMaxZ = Integer.MIN_VALUE;
+        int leftCount = 0, rightCount = 0;
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : left) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            leftCount++;
+            leftMaxX = Math.max(leftMaxX, s.sectionX);
+            leftMaxZ = Math.max(leftMaxZ, s.sectionZ);
+            leftMinX = Math.min(leftMinX, s.sectionX);
+            leftMinZ = Math.min(leftMinZ, s.sectionZ);
+        }
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : right) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            rightCount++;
+            rightMinX = Math.min(rightMinX, s.sectionX);
+            rightMinZ = Math.min(rightMinZ, s.sectionZ);
+            rightMaxX = Math.max(rightMaxX, s.sectionX);
+            rightMaxZ = Math.max(rightMaxZ, s.sectionZ);
+        }
+        if (leftCount == 0 || rightCount == 0) {
+            return new YapCorridorCarver.CorridorPlan(region.id, true, 0, 0, new LongOpenHashSet());
+        }
+
+        final int dx = Math.abs(rightMinX - leftMaxX);
+        final int dz = Math.abs(rightMinZ - leftMaxZ);
+        final boolean cutOnX = dx >= dz;
+        final int leftMax = cutOnX ? leftMaxX : leftMaxZ;
+        final int rightMin = cutOnX ? rightMinX : rightMinZ;
+        int corridorLo = Math.min(leftMax, rightMin);
+        int corridorHi = Math.max(leftMax, rightMin);
+        while ((corridorHi + 1) - (corridorLo - 1) < minGap) {
+            if (leftCount >= rightCount) {
+                corridorLo--;
+            } else {
+                corridorHi++;
+            }
+            if (corridorHi - corridorLo > minGap + 1) {
+                break;
+            }
+        }
+        // Extra section halo so sim-distance tickets from shard edges cannot re-pin the Folia gap.
+        // Default 2: with createRadius=1 and sim≈1–2, halo=1 still leaves section ±3 loaded and
+        // re-pins the corridor → inactive regions → frozen TNT (fuse gate fails).
+        // Never eat both shards' landing pads — a 6-section strip with halo=2 is the whole region.
+        final int requestedHalo = Math.max(0, Integer.getInteger("yap.folia.subregion-carve-halo-sections", 2));
+        final int landingMargin = Math.max(0, Integer.getInteger("yap.folia.subregion-carve-landing-margin", 1));
+        final int leftOuter = cutOnX ? leftMinX : leftMinZ;
+        final int rightOuter = cutOnX ? rightMaxX : rightMaxZ;
+        final int halo = Math.min(requestedHalo, Math.min(
+                Math.max(0, corridorLo - leftOuter - landingMargin),
+                Math.max(0, rightOuter - corridorHi - landingMargin)));
