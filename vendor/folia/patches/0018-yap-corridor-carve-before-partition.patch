+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import com.mojang.logging.LogUtils;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.entity.Entity;
+import org.bukkit.entity.Player;
+import org.slf4j.Logger;
+
+import java.util.List;
+
+/**
+ * Corridor/gap entity relocate, count, and same-thread landing-pad snaps.
+ */
+final class YapCorridorEntities {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private YapCorridorEntities() {
+    }
+
+    /** Returns {totalNonPlayerLocal, inCorridorKeys}. */
+    static int[] countCorridorEntities(final ServerLevel world, final YapCorridorCarver.CorridorPlan plan) {
+        final RegionizedWorldData data = world.getCurrentWorldData();
+        if (data == null) {
+            return new int[]{0, 0};
+        }
+        int total = 0;
+        int inBand = 0;
+        for (final net.minecraft.world.entity.Entity e : data.getLocalEntitiesCopy()) {
+            if (e == null || e instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            total++;
+            final long key = CoordinateUtils.getChunkKey(e.chunkPosition().x(), e.chunkPosition().z());
+            if (plan.keys().contains(key)) {
+                inBand++;
+            }
+        }
+        return new int[]{total, inBand};
+    }
+
+    static int[] pickSameThreadPad(final ServerLevel world, final YapCorridorPlanner.CarveLandings landings, final boolean leftPad) {
+        final int[][] pads = leftPad ? landings.left : landings.right;
+        if (pads.length == 0) {
+            return null;
+        }
+        for (int n = 0; n < pads.length; n++) {
+            final int[] dest = pads[Math.floorMod(landings.rr.getAndIncrement(), pads.length)];
+            if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, dest[0], dest[1])) {
+                return dest;
+            }
+        }
+        return pads[Math.floorMod(landings.rr.getAndIncrement(), pads.length)];
+    }
+
+    /** Same-region NMS snap — Bukkit teleport returns false for TNT/primed entities on Folia. */
+    static boolean relocateEntityToPad(
+            final ServerLevel world,
+            final net.minecraft.world.entity.Entity nms,
+            final int[] dest) {
+        final double x = (dest[0] << 4) + 8.0;
+        final double z = (dest[1] << 4) + 8.0;
+        double y = nms.getY();
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, dest[0], dest[1])) {
+            try {
+                y = Math.max(y, world.getHeight(
+                        net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING,
+                        (int) x, (int) z) + 1.0);
+            } catch (final Throwable ignored) {
+            }
+        }
+        final double ox = nms.getX();
+        final double oz = nms.getZ();
+        nms.teleportTo(x, y, z);
+        if (nms.chunkPosition().x() == dest[0] && nms.chunkPosition().z() == dest[1]) {
+            return true;
+        }
+        // snapTo can lag chunkPosition by a tick; treat a real move as success.
+        return Math.hypot(nms.getX() - ox, nms.getZ() - oz) > 4.0;
+    }
+
+    /**
+     * Move all region-local entities whose chunk is in the corridor onto landing pads.
+     * Uses {@link RegionizedWorldData#getLocalEntitiesCopy()} so we do not miss Folia entities
+     * that chunk AABB queries can skip from an anchor tick thread.
+     */
+    static void relocateCorridorBand(
+            final ServerLevel world,
+            final long regionId,
+            final YapCorridorCarver.CorridorPlan plan) {
+        final YapCorridorPlanner.CarveLandings landings = YapCorridorCarver.LANDINGS.get(regionId);
+        if (landings == null || plan.keys().isEmpty()) {
+            return;
+        }
+        final RegionizedWorldData data = world.getCurrentWorldData();
+        if (data == null) {
+            return;
+        }
+        final net.minecraft.world.entity.Entity[] local = data.getLocalEntitiesCopy();
+        for (final net.minecraft.world.entity.Entity nmsEntity : local) {
+            if (nmsEntity == null || nmsEntity instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            final int cx = nmsEntity.chunkPosition().x();
+            final int cz = nmsEntity.chunkPosition().z();
+            if (!plan.keys().contains(CoordinateUtils.getChunkKey(cx, cz))) {
+                continue;
+            }
+            try {
+                final boolean leftPad = plan.cutOnX() ? cx <= 0 : cz <= 0;
+                final int[] dest = pickSameThreadPad(world, landings, leftPad);
+                if (dest == null) {
+                    continue;
+                }
+                if (relocateEntityToPad(world, nmsEntity, dest)) {
+                    YapCorridorCarver.ENTITIES_RELOCATED.increment();
+                }
+            } catch (final Throwable ignored) {
+            }
+        }
+        LOGGER.info("YaP corridor band relocate region #{} — relocated+={} this pass",
+                regionId, YapCorridorCarver.ENTITIES_RELOCATED.sum());
+    }
+
+    /**
+     * Move entities onto shard landing pads. Never {@code remove()} — that games MSPT by
+     * destroying the bench load the soak is supposed to measure.
+     */
+    static void relocateCorridorEntities(final ServerLevel world, final long regionId,
+                                         final int cx, final int cz) {
+        final YapCorridorPlanner.CarveLandings landings = YapCorridorCarver.LANDINGS.get(regionId);
+        if (landings == null) {
+            return;
+        }
+        final org.bukkit.World bukkit = world.getWorld();
+        final net.minecraft.world.phys.AABB box = new net.minecraft.world.phys.AABB(
+                cx << 4, world.getMinY(), cz << 4,
+                (cx << 4) + 16, world.getMaxY() + 1, (cz << 4) + 16);
+        final List<net.minecraft.world.entity.Entity> snapshot =
+                world.getEntities((net.minecraft.world.entity.Entity) null, box, e -> true);
+        final boolean toLeft = cx < 0;
+        final int[][] pads = toLeft ? landings.left : landings.right;
+        if (pads.length == 0) {
+            return;
+        }
+        for (final net.minecraft.world.entity.Entity nmsEntity : snapshot) {
+            if (nmsEntity instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            // Only relocate entities actually in this chunk (AABB may spill edges).
+            if (nmsEntity.chunkPosition().x() != cx || nmsEntity.chunkPosition().z() != cz) {
+                continue;
+            }
+            try {
+                final int[] dest = pickSameThreadPad(world, landings, toLeft);
+                if (dest != null && relocateEntityToPad(world, nmsEntity, dest)) {
+                    YapCorridorCarver.ENTITIES_RELOCATED.increment();
+                }
+            } catch (final Throwable ignored) {
+                // Leave entity in place — unload will refuse rather than delete load.
+            }
+        }
+    }
+
+    static boolean corridorChunkHasNonPlayerEntities(final ServerLevel world, final int cx, final int cz) {
+        final net.minecraft.world.phys.AABB box = new net.minecraft.world.phys.AABB(
+                cx << 4, world.getMinY(), cz << 4,
+                (cx << 4) + 16, world.getMaxY() + 1, (cz << 4) + 16);
+        final List<net.minecraft.world.entity.Entity> found =
+                world.getEntities((net.minecraft.world.entity.Entity) null, box,
+                        e -> !(e instanceof net.minecraft.world.entity.player.Player)
+                                && e.chunkPosition().x() == cx && e.chunkPosition().z() == cz);
+        return !found.isEmpty();
+    }
+
+    static void relocateGapEntities(final YapCorridorPlanner.GapHold hold, final int cx, final int cz) {
+        final org.bukkit.World bukkit = hold.world.getWorld();
+        try {
+            if (!bukkit.isChunkLoaded(cx, cz)) {
+                return;
+            }
+            final org.bukkit.Chunk chunk = bukkit.getChunkAt(cx, cz);
+            final boolean toLeft = cx < 0;
+            final int[][] pads = toLeft ? hold.landings.left : hold.landings.right;
+            if (pads.length == 0) {
+                return;
+            }
+            for (final Entity entity : chunk.getEntities()) {
+                if (entity instanceof Player) {
+                    continue;
+                }
+                try {
+                    final int[] dest = pickSameThreadPad(hold.world, hold.landings, toLeft);
+                    if (dest == null) {
+                        continue;
+                    }
+                    final net.minecraft.world.entity.Entity nms =
+                            ((org.bukkit.craftbukkit.entity.CraftEntity) entity).getHandle();
+                    relocateEntityToPad(hold.world, nms, dest);
+                } catch (final Throwable ignored) {
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+    }
