+    /** Only when Bukkit unloaded AND Moonrise has no holder — sync regionizer bitset. */
+    static void repairRegionizer(final ServerLevel world, final int cx, final int cz) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr =
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) world)
+                            .moonrise$getChunkTaskScheduler().chunkHolderManager;
+            if (mgr.getChunkHolder(cx, cz) != null) {
+                // Holder still present — Moonrise will removeChunk; do not race it.
+                return;
+            }
+            world.regioniser.removeChunk(cx, cz);
+            YapCorridorCarver.REGIONIZER_REPAIRS.increment();
+            YapCorridorCarver.CHUNKS_UNLOADED.increment();
+        } catch (final IllegalStateException expected) {
+            YapCorridorCarver.CHUNKS_UNLOADED.increment();
+        } catch (final Throwable t) {
+            LOGGER.debug("YaP regionizer repair {},{}: {}", cx, cz, t.toString());
+        }
+    }
+
+    static void dropBukkitPins(final org.bukkit.World bukkit, final int cx, final int cz) {
+        try {
+            bukkit.setChunkForceLoaded(cx, cz, false);
+        } catch (final Throwable ignored) {
+        }
+        try {
+            for (final org.bukkit.plugin.Plugin plugin : org.bukkit.Bukkit.getPluginManager().getPlugins()) {
+                if (plugin != null) {
+                    bukkit.removePluginChunkTicket(cx, cz, plugin);
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+    }
+
+    static ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager holderManager(
+            final ServerLevel world) {
+        return ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) world)
+                .moonrise$getChunkTaskScheduler().chunkHolderManager;
+    }
+
+    /**
+     * Paper {@code purgeUnload} is a no-op. Drive Moonrise ticket propagation then
+     * {@link ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager#processUnloads()}
+     * on this region thread until the queue drains or we hit a cap.
+     */
+    static void flushCorridorUnloads(final ServerLevel world) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr = holderManager(world);
+            mgr.processTicketUpdates();
+            for (int i = 0; i < 48; ++i) {
+                mgr.processUnloads();
+            }
+        } catch (final Throwable t) {
+            LOGGER.warn("YaP corridor unload flush failed: {}", t.toString());
+        }
+    }
+
+    /** Drop pins/tickets from the region thread. Does not RTQ onto the corridor chunk. */
+    static void releaseCorridorTickets(final ServerLevel world, final long regionId, final int cx, final int cz) {
+        final org.bukkit.World bukkit = world.getWorld();
+        try {
+            world.setChunkForced(cx, cz, false);
+        } catch (final Throwable ignored) {
+        }
+        dropBukkitPins(bukkit, cx, cz);
+        if (bukkit.isChunkLoaded(cx, cz)) {
+            YapCorridorEntities.relocateCorridorEntities(world, regionId, cx, cz);
+        }
+        stripNonUnknownTickets(world, cx, cz);
+    }
+
+    /** Moonrise already dropped the holder — sync the regionizer bitset. */
+    static boolean reapCorridorHolder(final ServerLevel world, final int cx, final int cz) {
+        try {
+            if (holderManager(world).getChunkHolder(cx, cz) != null) {
+                return false;
+            }
+            repairRegionizer(world, cx, cz);
+            return true;
+        } catch (final Throwable t) {
+            return false;
+        }
+    }
