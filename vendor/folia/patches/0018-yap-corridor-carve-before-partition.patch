+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * YaP — unload a Folia-wide empty corridor between planned shard groups so
+ * {@link YapSubRegionPartitioner} can force-partition without TickThread violations.
+ *
+ * <p>Must not run while holding the regionizer write lock. Carve work is queued onto
+ * each corridor chunk's owning region tick thread via {@link RegionizedTaskQueue}.
+ *
+ * <p>Critical: when Bukkit already reports a chunk unloaded but the regionizer bitset
+ * still has it, call {@code regioniser.removeChunk} only (desync repair). Never call
+ * {@code removeChunk} and then {@code unloadChunk} — Moonrise will double-remove and crash.
+ */
+public final class YapCorridorCarver {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private static final boolean ENABLED = Boolean.parseBoolean(
+            System.getProperty("yap.folia.subregion-carve", "true"));
+
+    private static final LongAdder CARVES_STARTED = new LongAdder();
+    private static final LongAdder CARVES_COMPLETED = new LongAdder();
+    static final LongAdder CHUNKS_UNLOADED = new LongAdder();
+    static final LongAdder REGIONIZER_REPAIRS = new LongAdder();
+    static final LongAdder ENTITIES_RELOCATED = new LongAdder();
+
+    private static final ConcurrentHashMap<Long, Boolean> IN_FLIGHT = new ConcurrentHashMap<>();
+    /** Set when force-partition wins mid-carve — settler must stop unloading across new boundaries. */
+    private static final ConcurrentHashMap<Long, Boolean> CANCELLED = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<Long, Long> LAST_CARVE_DONE_MS = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<Long, Integer> CARVE_CYCLES = new ConcurrentHashMap<>();
+    /** region id → last corridor chunk keys (re-unpin before partition retries). */
+    private static final ConcurrentHashMap<Long, LongOpenHashSet> LAST_CORRIDOR = new ConcurrentHashMap<>();
+    /** region id → corridor plan while carve or until partition registers gap hold. */
+    private static final ConcurrentHashMap<Long, CorridorPlan> PENDING_PLANS = new ConcurrentHashMap<>();
+    /** region id → anchor chunk outside corridor for region-thread tasks. */
+    private static final ConcurrentHashMap<Long, int[]> PENDING_ANCHORS = new ConcurrentHashMap<>();
+    /** Per-carve landing pads so corridor entities are moved, not deleted (fair MSPT). */
+    static final ConcurrentHashMap<Long, YapCorridorPlanner.CarveLandings> LANDINGS = new ConcurrentHashMap<>();
+    /** shard group → post-partition gap hold (prevents sim-distance re-pin → inactive shards). */
+    private static final ConcurrentHashMap<Long, YapCorridorPlanner.GapHold> GAP_HOLDS = new ConcurrentHashMap<>();
+
+    private static final long CARVE_COOLDOWN_MS = Math.max(1000L,
+            Long.getLong("yap.folia.subregion-carve-cooldown-ms", 12000L));
+    private static final int MAX_CARVE_CYCLES = Math.max(1,
+            Integer.getInteger("yap.folia.subregion-carve-max-cycles", 4));
+    private static final long SETTLE_MS = Math.max(500L,
+            Long.getLong("yap.folia.subregion-carve-settle-ms", 2500L));
+    private static final int GAP_MAINTAIN_INTERVAL = Math.max(1,
+            Integer.getInteger("yap.folia.subregion-gap-maintain-interval", 10));
+    private static final LongAdder GAP_MAINTAIN_PASSES = new LongAdder();
+
+    private YapCorridorCarver() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    public static boolean recentlyCarved(final long regionId) {
+        final Long t = LAST_CARVE_DONE_MS.get(regionId);
+        return t != null && (System.currentTimeMillis() - t.longValue()) < CARVE_COOLDOWN_MS;
+    }
+
+    public static boolean isInFlight(final long regionId) {
+        return IN_FLIGHT.containsKey(regionId);
+    }
+
+    public static void onForcePartitionSuccess(
+            final long regionId,
+            final long shardGroup,
+            final ServerLevel world,
+            final CorridorPlan plan,
+            final int[] anchor) {
+        CANCELLED.put(regionId, Boolean.TRUE);
+        IN_FLIGHT.remove(regionId);
+        CARVE_CYCLES.remove(regionId);
+        LAST_CARVE_DONE_MS.put(regionId, System.currentTimeMillis());
+        final YapCorridorPlanner.CarveLandings landings = LANDINGS.remove(regionId);
+        PENDING_PLANS.remove(regionId);
+        PENDING_ANCHORS.remove(regionId);
+        LAST_CORRIDOR.remove(regionId);
+        if (shardGroup != 0L && world != null && plan != null && anchor != null && !plan.keys().isEmpty()) {
+            GAP_HOLDS.put(shardGroup, new YapCorridorPlanner.GapHold(world, plan, anchor.clone(), landings));
+            LOGGER.info("YaP gap hold registered shard-group {} — {} corridor chunks lo={} hi={}",
+                    shardGroup, plan.keys().size(), plan.lo(), plan.hi());
+        }
+    }
+
+    /** Drop gap maintenance when shard group coalesces back to one region. */
+    public static void releaseGapHold(final long shardGroup) {
+        if (shardGroup != 0L) {
+            GAP_HOLDS.remove(shardGroup);
+        }
+    }
+
+    /**
+     * Periodic maintenance while shards tick in parallel — strip sim tickets and unload
+     * corridor chunks that entity sim-distance re-pins after partition.
+     */
+    public static void tickGapHold(final long shardGroup) {
+        final YapCorridorPlanner.GapHold hold = GAP_HOLDS.get(shardGroup);
+        if (hold == null) {
+            return;
+        }
+        final int tick = hold.tickCounter.incrementAndGet();
+        if (tick % GAP_MAINTAIN_INTERVAL != 0) {
+            return;
+        }
+        GAP_MAINTAIN_PASSES.increment();
+        // Fire-and-forget on a daemon — never block the global RegionizedServer task queue.
+        final Thread maint = new Thread(() -> YapCorridorUnload.maintainGapBand(hold), "yap-gap-maintain-" + shardGroup);
+        maint.setDaemon(true);
+        maint.start();
+    }
+
+    private static boolean isCancelled(final long regionId) {
+        return CANCELLED.containsKey(regionId);
+    }
+
+    public static long carvesStarted() {
+        return CARVES_STARTED.sum();
+    }
+
+    public static long carvesCompleted() {
+        return CARVES_COMPLETED.sum();
+    }
+
+    public static long chunksUnloaded() {
+        return CHUNKS_UNLOADED.sum();
+    }
+
+    public static String snapshot() {
+        return "carve=" + ENABLED
+                + " started=" + carvesStarted()
+                + " completed=" + carvesCompleted()
+                + " unloaded=" + chunksUnloaded()
+                + " relocated=" + ENTITIES_RELOCATED.sum()
+                + " repairs=" + REGIONIZER_REPAIRS.sum()
+                + " inflight=" + IN_FLIGHT.size()
+                + " gapHolds=" + GAP_HOLDS.size()
+                + " gapPasses=" + GAP_MAINTAIN_PASSES.sum();
+    }
+
+    public static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    boolean scheduleCarve(
+            final ThreadedRegionizer.ThreadedRegion<R, S> region,
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final int shardCount) {
+        if (!ENABLED || region == null || groups == null || groups.size() < 2) {
+            return false;
+        }
+        if (!(region.getData() instanceof TickRegions.TickRegionData tickData)) {
+            return false;
+        }
+        if (IN_FLIGHT.putIfAbsent(region.id, Boolean.TRUE) != null) {
+            return false;
+        }
+        if (recentlyCarved(region.id)) {
+            IN_FLIGHT.remove(region.id);
+            return false;
+        }
+        if (CARVE_CYCLES.getOrDefault(region.id, 0) >= MAX_CARVE_CYCLES) {
+            IN_FLIGHT.remove(region.id);
+            return false;
+        }
+        CANCELLED.remove(region.id);
+
+        final int createRadius = Math.max(1, region.regioniser.emptySectionCreateRadius);
+        final CorridorPlan plan = planCorridor(region, groups, createRadius);
+        if (plan.keys().isEmpty()) {
+            IN_FLIGHT.remove(region.id);
+            return false;
+        }
+        final YapCorridorPlanner.CarveLandings landings = YapCorridorPlanner.CarveLandings.fromGroups(groups, plan);
+        if (landings == null) {
+            IN_FLIGHT.remove(region.id);
+            LOGGER.warn("YaP corridor carve region #{} aborted — no shard landing pads", region.id);
+            return false;
+        }
+
+        final ServerLevel world = tickData.world;
+        final long regionId = region.id;
+        CARVES_STARTED.increment();
+        CARVE_CYCLES.merge(region.id, 1, Integer::sum);
+        LAST_CORRIDOR.put(regionId, new LongOpenHashSet(plan.keys()));
+        PENDING_PLANS.put(regionId, plan);
+        LANDINGS.put(regionId, landings);
+        LOGGER.info("YaP corridor carve start region #{} — {} chunks lo={} hi={} axis={} gapR={} cycle {}/{} (relocate, not delete)",
+                regionId, plan.keys().size(), plan.lo(), plan.hi(), plan.cutOnX() ? "X" : "Z",
+                createRadius, CARVE_CYCLES.get(region.id), MAX_CARVE_CYCLES);
+
+        // Anchor OUTSIDE the corridor so task_queue_ticket does not pin chunks we unload.
+        final int[] anchor = firstNonEmptyChunkOutside(groups, plan);
+        if (anchor == null) {
+            IN_FLIGHT.remove(region.id);
+            LANDINGS.remove(regionId);
+            LOGGER.warn("YaP corridor carve region #{} aborted — no outside-corridor anchor", regionId);
+            return false;
+        }
+        PENDING_ANCHORS.put(regionId, anchor.clone());
+
+        final LongOpenHashSet keysCopy = new LongOpenHashSet(plan.keys());
+        final int shards = shardCount;
+        final int unloadRounds = Math.max(2, Integer.getInteger("yap.folia.subregion-carve-unload-rounds", 8));
+        final Thread settler = new Thread(() -> {
+            try {
+                // Do NOT bulk-unforce corridor chunks up front — that unloads TNT before relocate.
+                // First move every corridor entity onto landing pads via region-local entity list.
+                final java.util.concurrent.atomic.AtomicBoolean abortEvacuate =
+                        new java.util.concurrent.atomic.AtomicBoolean(false);
+                if (!runOnAnchor(world, anchor, 120L, () -> {
+                    final long before = ENTITIES_RELOCATED.sum();
+                    final int[] scan = YapCorridorEntities.countCorridorEntities(world, plan);
+                    YapCorridorEntities.relocateCorridorBand(world, regionId, plan);
+                    final long moved = ENTITIES_RELOCATED.sum() - before;
+                    LOGGER.info("YaP corridor evacuate region #{} — local={} inCorridor={} relocated+={}",
+                            regionId, scan[0], scan[1], moved);
+                    if (scan[1] > 0 && moved <= 0) {
+                        LOGGER.warn("YaP corridor carve region #{} abort evacuate — local={} inCorridor={} moved={}",
+                                regionId, scan[0], scan[1], moved);
+                        abortEvacuate.set(true);
+                    }
+                })) {
+                    LOGGER.warn("YaP corridor carve region #{} evacuate wave timed out", regionId);
+                }
+                if (abortEvacuate.get()) {
+                    RegionizedServer.getInstance().addTask(() -> finishCarve(regionId, shards, world, plan));
+                    return;
+                }
+                // Strip tickets from the outside-corridor anchor. Never RTQ on corridor
+                // chunks — REGION_SCHEDULER_API_HOLD pins them (unload then never happens).
+                if (!runOnAnchor(world, anchor, 120L, () -> {
+                    for (final long key : keysCopy) {
+                        final int cx = CoordinateUtils.getChunkX(key);
+                        final int cz = CoordinateUtils.getChunkZ(key);
+                        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, cx, cz)) {
+                            continue;
+                        }
+                        YapCorridorUnload.releaseCorridorTickets(world, regionId, cx, cz);
+                    }
+                })) {
+                    LOGGER.warn("YaP corridor carve region #{} ticket-strip timed out", regionId);
+                }
+                for (int round = 0; round < unloadRounds; ++round) {
+                    if (isCancelled(regionId)) {
+                        LOGGER.info("YaP corridor carve region #{} aborted mid-unload — force-partition won", regionId);
+                        CANCELLED.remove(regionId);
+                        return;
+                    }
+                    // removeTicketAtLevel replaces the last real ticket with UNKNOWN (1-tick).
+                    // Wait for expiry before reaping holders / regionizer bits.
+                    Thread.sleep(SETTLE_MS);
+                    final LongOpenHashSet still = YapCorridorPlanner.collectCorridorKeysFromWorld(world, plan);
+                    if (still.isEmpty()) {
+                        LOGGER.info("YaP corridor carve region #{} emptied after wait round {}", regionId, round);
+                        break;
+                    }
+                    final int roundNo = round;
+                    if (!runOnAnchor(world, anchor, 120L, () -> {
+                        // Paper purgeUnload is a no-op; Moonrise processUnloads is the real drop.
+                        YapCorridorUnload.flushCorridorUnloads(world);
+                        int reaped = 0;
+                        int held = 0;
+                        String leftoverTickets = null;
+                        for (final long key : still) {
+                            final int cx = CoordinateUtils.getChunkX(key);
+                            final int cz = CoordinateUtils.getChunkZ(key);
+                            if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, cx, cz)) {
+                                continue;
+                            }
+                            if (YapCorridorUnload.reapCorridorHolder(world, cx, cz)) {
+                                reaped++;
+                            } else {
+                                held++;
+                                if (leftoverTickets == null) {
+                                    leftoverTickets = YapCorridorUnload.describeTickets(world, cx, cz);
+                                }
+                                YapCorridorUnload.releaseCorridorTickets(world, regionId, cx, cz);
+                            }
+                        }
+                        LOGGER.info("YaP corridor carve region #{} reap round {} — reaped={} stillHeld={} regionizer={} tickets={}",
+                                regionId, roundNo, reaped, held, still.size(), leftoverTickets);
+                    })) {
+                        LOGGER.warn("YaP corridor carve region #{} reap round {} timed out", regionId, round);
+                    }
+                    if (isCancelled(regionId)) {
+                        LOGGER.info("YaP corridor carve region #{} aborted after round {} — force-partition won",
+                                regionId, round);
+                        CANCELLED.remove(regionId);
+                        return;
+                    }
+                    final LongOpenHashSet after = YapCorridorPlanner.collectCorridorKeysFromWorld(world, plan);
+                    if (after.isEmpty()) {
+                        LOGGER.info("YaP corridor carve region #{} emptied after reap round {}", regionId, round);
+                        break;
+                    }
+                }
+                if (isCancelled(regionId)) {
+                    CANCELLED.remove(regionId);
+                    return;
+                }
+                Thread.sleep(Math.max(200L, SETTLE_MS / 5));
+                RegionizedServer.getInstance().addTask(() -> secondPassAndPartition(world, regionId, plan, shards, anchor));
+            } catch (final InterruptedException e) {
+                Thread.currentThread().interrupt();
+                IN_FLIGHT.remove(regionId);
+            }
+        }, "yap-carve-settle-" + regionId);
+        settler.setDaemon(true);
+        settler.start();
+        return true;
+    }
+
+    /** Run work on the outside-corridor anchor tick thread (does not pin corridor chunks). */
+    static boolean runOnAnchor(
+            final ServerLevel world,
+            final int[] anchor,
+            final long awaitSeconds,
+            final Runnable work) {
+        final CountDownLatch done = new CountDownLatch(1);
+        try {
+            RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(world, anchor[0], anchor[1], () -> {
+                try {
+                    work.run();
+                } catch (final Throwable t) {
+                    LOGGER.error("YaP corridor anchor-wave failed at {},{}", anchor[0], anchor[1], t);
+                } finally {
+                    done.countDown();
+                }
+            });
+        } catch (final Throwable t) {
+            LOGGER.error("YaP corridor anchor schedule failed", t);
+            done.countDown();
+        }
+        try {
+            return done.await(awaitSeconds, TimeUnit.SECONDS);
+        } catch (final InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return false;
+        }
+    }
+
+    private static void secondPassAndPartition(
+            final ServerLevel world,
+            final long regionId,
+            final CorridorPlan plan,
+            final int shards,
+            final int[] anchor) {
+        if (isCancelled(regionId)) {
+            CANCELLED.remove(regionId);
+            LOGGER.info("YaP corridor carve region #{} skip second pass — already partitioned", regionId);
+            return;
+        }
+        try {
+            final LongOpenHashSet remaining = YapCorridorPlanner.collectCorridorKeysFromWorld(world, plan);
+            if (!remaining.isEmpty()) {
+                LOGGER.info("YaP corridor carve region #{} second pass — {} keys still in regionizer",
+                        regionId, remaining.size());
+                for (final long key : remaining) {
+                    try {
+                        world.setChunkForced(CoordinateUtils.getChunkX(key), CoordinateUtils.getChunkZ(key), false);
+                    } catch (final Throwable ignored) {
+                    }
+                }
+                final Thread wait = new Thread(() -> {
+                    try {
+                        runOnAnchor(world, anchor, 90L, () -> {
+                            for (final long key : remaining) {
+                                final int cx = CoordinateUtils.getChunkX(key);
+                                final int cz = CoordinateUtils.getChunkZ(key);
+                                if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, cx, cz)) {
+                                    continue;
+                                }
+                                YapCorridorUnload.releaseCorridorTickets(world, regionId, cx, cz);
+                            }
+                        });
+                        Thread.sleep(SETTLE_MS);
+                        runOnAnchor(world, anchor, 90L, () -> {
+                            YapCorridorUnload.flushCorridorUnloads(world);
+                            for (final long key : remaining) {
+                                YapCorridorUnload.reapCorridorHolder(world, CoordinateUtils.getChunkX(key),
+                                        CoordinateUtils.getChunkZ(key));
+                            }
+                        });
+                        Thread.sleep(SETTLE_MS);
+                        finishCarve(regionId, shards, world, plan);
+                    } catch (final InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        IN_FLIGHT.remove(regionId);
+                    }
+                }, "yap-carve-settle2-" + regionId);
+                wait.setDaemon(true);
+                wait.start();
+                return;
+            }
+            final Thread wait = new Thread(() -> {
+                try {
+                    Thread.sleep(SETTLE_MS);
+                    finishCarve(regionId, shards, world, plan);
+                } catch (final InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    IN_FLIGHT.remove(regionId);
+                }
+            }, "yap-carve-settle2-" + regionId);
+            wait.setDaemon(true);
+            wait.start();
+        } catch (final Throwable t) {
+            LOGGER.error("YaP corridor second pass failed region #{}", regionId, t);
+            IN_FLIGHT.remove(regionId);
+        }
+    }
+
+    private static void finishCarve(final long regionId, final int shards,
+                                    final ServerLevel world, final CorridorPlan plan) {
+        if (isCancelled(regionId)) {
+            CANCELLED.remove(regionId);
+            LANDINGS.remove(regionId);
+            return;
+        }
+        final LongOpenHashSet still = YapCorridorPlanner.collectCorridorKeysFromWorld(world, plan);
+        if (!still.isEmpty()) {
+            // Incomplete gap → force-partition would freeze load in non-ticking chunks (fuse_ok=false).
+            LOGGER.warn("YaP corridor carve region #{} abort partition — {} corridor keys remain (relocated≈{} unloaded≈{})",
+                    regionId, still.size(), ENTITIES_RELOCATED.sum(), chunksUnloaded());
+            IN_FLIGHT.remove(regionId);
+            LANDINGS.remove(regionId);
+            PENDING_PLANS.remove(regionId);
+            PENDING_ANCHORS.remove(regionId);
+            LAST_CARVE_DONE_MS.put(regionId, System.currentTimeMillis());
+            return;
+        }
+        IN_FLIGHT.remove(regionId);
+        CARVES_COMPLETED.increment();
+        LAST_CARVE_DONE_MS.put(regionId, System.currentTimeMillis());
+        LANDINGS.remove(regionId);
+        RegionizedServer.getInstance().addTask(() ->
+                YapSubRegionPartitioner.requestPartition(regionId, shards));
+        final Thread t = new Thread(() -> {
+            try {
+                for (final long delay : new long[]{1000L, 2500L, 5000L}) {
+                    Thread.sleep(delay);
+                    if (isCancelled(regionId)) {
+                        CANCELLED.remove(regionId);
+                        return;
+                    }
+                    RegionizedServer.getInstance().addTask(() ->
+                            YapSubRegionPartitioner.requestPartition(regionId, shards));
+                }
+            } catch (final InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        }, "yap-carve-partition-retry-" + regionId);
+        t.setDaemon(true);
+        t.start();
+        LOGGER.info("YaP corridor carve complete region #{} — unloaded≈{} relocated≈{} repairs={} settle={}ms — partition requested",
+                regionId, chunksUnloaded(), ENTITIES_RELOCATED.sum(), REGIONIZER_REPAIRS.sum(), SETTLE_MS);
+    }
+
+    record CorridorPlan(long regionId, boolean cutOnX, int lo, int hi, LongOpenHashSet keys) {
+    }
+
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    CorridorPlan planCorridor(
+            final ThreadedRegionizer.ThreadedRegion<R, S> region,
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final int createRadius) {
+        return YapCorridorPlanner.planCorridor(region, groups, createRadius);
+    }
+
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    int[] firstNonEmptyChunkOutside(
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final CorridorPlan plan) {
+        return YapCorridorPlanner.firstNonEmptyChunkOutside(groups, plan);
+    }
