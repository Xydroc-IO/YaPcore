+    /** Strip sim tickets and unload corridor chunks re-pinned after partition — no regionizer.removeChunk. */
+    private static void maintainGapChunk(final GapHold hold, final int cx, final int cz) {
+        final org.bukkit.World bukkit = hold.world.getWorld();
+        if (hold.landings != null) {
+            relocateGapEntities(hold, cx, cz);
+        }
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            return;
+        }
+        if (corridorChunkHasNonPlayerEntities(hold.world, cx, cz)) {
+            return;
+        }
+        stripNonUnknownTickets(hold.world, cx, cz);
+        hold.world.getChunkSource().purgeUnload();
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            return;
+        }
+        bukkit.unloadChunkRequest(cx, cz);
+        hold.world.getChunkSource().purgeUnload();
+    }
+
+    private static void relocateGapEntities(final GapHold hold, final int cx, final int cz) {
+        final org.bukkit.World bukkit = hold.world.getWorld();
+        try {
+            if (!bukkit.isChunkLoaded(cx, cz)) {
+                return;
+            }
+            final org.bukkit.Chunk chunk = bukkit.getChunkAt(cx, cz);
+            final boolean toLeft = cx < 0;
+            final int[][] pads = toLeft ? hold.landings.left : hold.landings.right;
+            if (pads.length == 0) {
+                return;
+            }
+            for (final Entity entity : chunk.getEntities()) {
+                if (entity instanceof Player) {
+                    continue;
+                }
+                try {
+                    final int i = Math.floorMod(hold.landings.rr.getAndIncrement(), pads.length);
+                    final int[] dest = pads[i];
+                    final double x = (dest[0] << 4) + 8.0;
+                    final double z = (dest[1] << 4) + 8.0;
+                    final double y = Math.max(entity.getLocation().getY(),
+                            bukkit.getHighestBlockYAt((int) x, (int) z) + 1.0);
+                    entity.teleport(new org.bukkit.Location(bukkit, x, y, z));
+                } catch (final Throwable ignored) {
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+    }
+
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    CorridorPlan planCorridor(
+            final ThreadedRegionizer.ThreadedRegion<R, S> region,
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final int createRadius) {
+        final int minGap = 2 * createRadius + 1;
+        final int maxChunks = Math.max(64, Integer.getInteger("yap.folia.subregion-carve-max-chunks", 4096));
+
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> left = groups.get(0);
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> right = groups.get(groups.size() - 1);
+        int leftMaxX = Integer.MIN_VALUE, leftMaxZ = Integer.MIN_VALUE;
+        int rightMinX = Integer.MAX_VALUE, rightMinZ = Integer.MAX_VALUE;
+        int leftCount = 0, rightCount = 0;
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : left) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            leftCount++;
+            leftMaxX = Math.max(leftMaxX, s.sectionX);
+            leftMaxZ = Math.max(leftMaxZ, s.sectionZ);
+        }
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : right) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            rightCount++;
+            rightMinX = Math.min(rightMinX, s.sectionX);
+            rightMinZ = Math.min(rightMinZ, s.sectionZ);
+        }
+        if (leftCount == 0 || rightCount == 0) {
+            return new CorridorPlan(region.id, true, 0, 0, new LongOpenHashSet());
+        }
+
+        final int dx = Math.abs(rightMinX - leftMaxX);
+        final int dz = Math.abs(rightMinZ - leftMaxZ);
+        final boolean cutOnX = dx >= dz;
+        final int leftMax = cutOnX ? leftMaxX : leftMaxZ;
+        final int rightMin = cutOnX ? rightMinX : rightMinZ;
+        int corridorLo = Math.min(leftMax, rightMin);
+        int corridorHi = Math.max(leftMax, rightMin);
+        while ((corridorHi + 1) - (corridorLo - 1) < minGap) {
+            if (leftCount >= rightCount) {
+                corridorLo--;
+            } else {
+                corridorHi++;
+            }
+            if (corridorHi - corridorLo > minGap + 1) {
+                break;
+            }
+        }
+        // Extra section halo so sim-distance tickets from shard edges cannot re-pin the Folia gap.
+        // Default 2: with createRadius=1 and sim≈1–2, halo=1 still leaves section ±3 loaded and
+        // re-pins the corridor → inactive regions → frozen TNT (fuse gate fails).
+        final int halo = Math.max(0, Integer.getInteger("yap.folia.subregion-carve-halo-sections", 2));
+        corridorLo -= halo;
+        corridorHi += halo;
+
+        // Collect from the whole region (not just group lists) so every bitset chunk in the band is targeted.
+        final LongOpenHashSet keys = new LongOpenHashSet();
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sections = region.copySections();
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : sections) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            final int coord = cutOnX ? s.sectionX : s.sectionZ;
+            if (coord < corridorLo || coord > corridorHi) {
+                continue;
+            }
+            final LongArrayList chunks = s.getChunks();
+            for (int i = 0; i < chunks.size(); ++i) {
+                keys.add(chunks.getLong(i));
+                if (keys.size() >= maxChunks) {
+                    LOGGER.warn("YaP corridor carve capped at {} chunks (lo={} hi={})",
+                            maxChunks, corridorLo, corridorHi);
+                    return new CorridorPlan(region.id, cutOnX, corridorLo, corridorHi, keys);
+                }
+            }
+        }
+        return new CorridorPlan(region.id, cutOnX, corridorLo, corridorHi, keys);
+    }
+
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    int[] firstNonEmptyChunkOutside(
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+            final CorridorPlan plan) {
+        for (final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> group : groups) {
+            for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : group) {
+                if (s.isEmpty()) {
+                    continue;
+                }
+                final int coord = plan.cutOnX ? s.sectionX : s.sectionZ;
+                if (coord >= plan.lo && coord <= plan.hi) {
+                    continue;
+                }
+                final LongArrayList chunks = s.getChunks();
+                if (!chunks.isEmpty()) {
+                    final long key = chunks.getLong(0);
+                    return new int[]{CoordinateUtils.getChunkX(key), CoordinateUtils.getChunkZ(key)};
+                }
+            }
+        }
+        return null;
+    }
+
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    int[] firstNonEmptyChunk(final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> group) {
+        for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : group) {
+            if (s.isEmpty()) {
+                continue;
+            }
+            final LongArrayList chunks = s.getChunks();
+            if (!chunks.isEmpty()) {
+                final long key = chunks.getLong(0);
+                return new int[]{CoordinateUtils.getChunkX(key), CoordinateUtils.getChunkZ(key)};
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Landing pads on left/right shards. Corridor entities are teleported here so carve
+     * does not delete load (citeable MSPT requires entity/TNT parity with stock).
+     */
+    private static final class CarveLandings {
+        private final int[][] left;
+        private final int[][] right;
+        private final AtomicInteger rr = new AtomicInteger();
+
+        private CarveLandings(final int[][] left, final int[][] right) {
+            this.left = left;
+            this.right = right;
+        }
+
+        static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+        CarveLandings fromGroups(
+                final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups,
+                final CorridorPlan plan) {
+            // Stay clear of the corridor so sim-distance tickets cannot re-pin the Folia gap.
+            // Default margin=1 section (~16 chunks) — strip benches need half-width ≳40.
+            final int margin = Math.max(1, Integer.getInteger("yap.folia.subregion-carve-landing-margin", 1));
+            final int[][] left = collectOutsideChunks(groups.get(0), plan, margin, 24, true);
+            final int[][] right = collectOutsideChunks(groups.get(groups.size() - 1), plan, margin, 24, false);
+            if (left.length == 0 || right.length == 0) {
+                return null;
+            }
+            return new CarveLandings(left, right);
+        }
+
+        private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+        int[][] collectOutsideChunks(
+                final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> group,
+                final CorridorPlan plan,
+                final int margin,
+                final int max,
+                final boolean leftSide) {
+            final int sectionShift = 4; // Folia default grid-exponent=4 → 16-chunk sections
+            final int sectionSize = 1 << sectionShift;
+            final List<int[]> scored = new ArrayList<>();
+            for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : group) {
+                if (s.isEmpty()) {
+                    continue;
+                }
+                final int coord = plan.cutOnX ? s.sectionX : s.sectionZ;
+                if (leftSide) {
+                    if (coord > plan.lo - margin) {
+                        continue;
+                    }
+                } else if (coord < plan.hi + margin) {
+                    continue;
+                }
+                final LongArrayList chunks = s.getChunks();
+                for (int i = 0; i < chunks.size(); ++i) {
+                    final long key = chunks.getLong(i);
+                    final int cx = CoordinateUtils.getChunkX(key);
+                    final int cz = CoordinateUtils.getChunkZ(key);
+                    final int along = plan.cutOnX ? cx : cz;
+                    // Distance from nearest corridor edge (chunks) — prefer strip tips.
+                    final int dist = leftSide
+                            ? (plan.lo * sectionSize) - along
+                            : along - ((plan.hi + 1) * sectionSize - 1);
+                    scored.add(new int[]{cx, cz, dist});
+                }
+            }
+            scored.sort((a, b) -> Integer.compare(b[2], a[2]));
+            final int n = Math.min(max, scored.size());
+            final int[][] out = new int[n][];
+            for (int i = 0; i < n; ++i) {
+                out[i] = new int[]{scored.get(i)[0], scored.get(i)[1]};
+            }
+            return out;
+        }
+
+        int[] pick(final int cx, final int cz, final CorridorPlan plan) {
+            final boolean toLeft = plan.cutOnX ? cx < 0 : cz < 0;
+            final int[][] pads = toLeft ? left : right;
+            final int i = Math.floorMod(rr.getAndIncrement(), pads.length);
+            return pads[i];
+        }
+    }
+
+    /**
+     * Evacuate + optionally soft-unload one corridor chunk, or repair regionizer desync if Bukkit already unloaded it.
+     * @param unloadOnly if true, attempt soft unload after relocate (never hard {@code unloadChunk}).
+     */
+    private static void carveOneChunk(final ServerLevel world, final long regionId, final int cx, final int cz,
+                                      final boolean unloadOnly) {
+        final org.bukkit.World bukkit = world.getWorld();
+
+        // Relocate WHILE chunk is still held (force-loaded / tickets). Unforcing first orphans TNT.
+        if (bukkit.isChunkLoaded(cx, cz)) {
+            relocateCorridorEntities(world, regionId, cx, cz);
+            if (corridorChunkHasNonPlayerEntities(world, cx, cz)) {
+                return;
+            }
+        }
+
+        try {
+            world.setChunkForced(cx, cz, false);
+        } catch (final Throwable ignored) {
+        }
+
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            if (!unloadOnly) {
+                stripNonUnknownTickets(world, cx, cz);
+            }
+            world.getChunkSource().purgeUnload();
+            repairRegionizer(world, cx, cz);
+            return;
+        }
+
+        stripNonUnknownTickets(world, cx, cz);
+        if (!unloadOnly) {
+            return;
+        }
+        if (corridorChunkHasNonPlayerEntities(world, cx, cz)) {
+            return;
+        }
+        bukkit.unloadChunkRequest(cx, cz);
+        world.getChunkSource().purgeUnload();
+        if (!bukkit.isChunkLoaded(cx, cz)) {
+            repairRegionizer(world, cx, cz);
+            CHUNKS_UNLOADED.increment();
+        }
+    }
+
+    private static void carveOneChunk(final ServerLevel world, final long regionId, final int cx, final int cz) {
+        carveOneChunk(world, regionId, cx, cz, false);
+    }
+
+    /** Returns {totalNonPlayerLocal, inCorridorKeys}. */
+    private static int[] countCorridorEntities(final ServerLevel world, final CorridorPlan plan) {
+        final RegionizedWorldData data = world.getCurrentWorldData();
+        if (data == null) {
+            return new int[]{0, 0};
+        }
+        int total = 0;
+        int inBand = 0;
+        for (final net.minecraft.world.entity.Entity e : data.getLocalEntitiesCopy()) {
+            if (e == null || e instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            total++;
+            final long key = CoordinateUtils.getChunkKey(e.chunkPosition().x(), e.chunkPosition().z());
+            if (plan.keys.contains(key)) {
+                inBand++;
+            }
+        }
+        return new int[]{total, inBand};
+    }
+
+    /**
+     * Move all region-local entities whose chunk is in the corridor onto landing pads.
+     * Uses {@link RegionizedWorldData#getLocalEntitiesCopy()} so we do not miss Folia entities
+     * that chunk AABB queries can skip from an anchor tick thread.
+     */
+    private static void relocateCorridorBand(
+            final ServerLevel world,
+            final long regionId,
+            final CorridorPlan plan) {
+        final CarveLandings landings = LANDINGS.get(regionId);
+        if (landings == null || plan.keys.isEmpty()) {
+            return;
+        }
+        final org.bukkit.World bukkit = world.getWorld();
+        final RegionizedWorldData data = world.getCurrentWorldData();
+        if (data == null) {
+            return;
+        }
+        final net.minecraft.world.entity.Entity[] local = data.getLocalEntitiesCopy();
+        for (final net.minecraft.world.entity.Entity nmsEntity : local) {
+            if (nmsEntity == null || nmsEntity instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            final int cx = nmsEntity.chunkPosition().x();
+            final int cz = nmsEntity.chunkPosition().z();
+            if (!plan.keys.contains(CoordinateUtils.getChunkKey(cx, cz))) {
+                continue;
+            }
+            try {
+                // Midpoint of corridor in chunk coords; origin-centered strip → leftPad by sign.
+                final boolean leftPad = plan.cutOnX ? cx <= 0 : cz <= 0;
+                final int[][] pads = leftPad ? landings.left : landings.right;
+                if (pads.length == 0) {
+                    continue;
+                }
+                final int i = Math.floorMod(landings.rr.getAndIncrement(), pads.length);
+                final int[] dest = pads[i];
+                final double x = (dest[0] << 4) + 8.0;
+                final double z = (dest[1] << 4) + 8.0;
+                final double y = Math.max(nmsEntity.getY(), world.getHeight(
+                        net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING,
+                        (int) x, (int) z) + 1.0);
+                if (nmsEntity.getBukkitEntity().teleport(new org.bukkit.Location(bukkit, x, y, z))) {
+                    ENTITIES_RELOCATED.increment();
+                }
+            } catch (final Throwable ignored) {
+            }
+        }
+        LOGGER.info("YaP corridor band relocate region #{} — relocated+={} this pass",
+                regionId, ENTITIES_RELOCATED.sum());
+    }
+
+    /**
+     * Move entities onto shard landing pads. Never {@code remove()} — that games MSPT by
+     * destroying the bench load the soak is supposed to measure.
+     */
+    private static void relocateCorridorEntities(final ServerLevel world, final long regionId,
+                                                 final int cx, final int cz) {
+        final CarveLandings landings = LANDINGS.get(regionId);
+        if (landings == null) {
+            return;
+        }
+        final org.bukkit.World bukkit = world.getWorld();
+        final net.minecraft.world.phys.AABB box = new net.minecraft.world.phys.AABB(
+                cx << 4, world.getMinY(), cz << 4,
+                (cx << 4) + 16, world.getMaxY() + 1, (cz << 4) + 16);
+        final List<net.minecraft.world.entity.Entity> snapshot =
+                world.getEntities((net.minecraft.world.entity.Entity) null, box, e -> true);
+        final boolean toLeft = cx < 0;
+        final int[][] pads = toLeft ? landings.left : landings.right;
+        if (pads.length == 0) {
+            return;
+        }
+        for (final net.minecraft.world.entity.Entity nmsEntity : snapshot) {
+            if (nmsEntity instanceof net.minecraft.world.entity.player.Player) {
+                continue;
+            }
+            // Only relocate entities actually in this chunk (AABB may spill edges).
+            if (nmsEntity.chunkPosition().x() != cx || nmsEntity.chunkPosition().z() != cz) {
+                continue;
+            }
+            try {
+                final int i = Math.floorMod(landings.rr.getAndIncrement(), pads.length);
+                final int[] dest = pads[i];
+                final double x = (dest[0] << 4) + 8.0;
+                final double z = (dest[1] << 4) + 8.0;
+                final double y = Math.max(nmsEntity.getY(), world.getHeight(
+                        net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING,
+                        (int) x, (int) z) + 1.0);
+                final Entity bukkitEntity = nmsEntity.getBukkitEntity();
+                if (bukkitEntity.teleport(new org.bukkit.Location(bukkit, x, y, z))) {
+                    ENTITIES_RELOCATED.increment();
+                }
+            } catch (final Throwable ignored) {
+                // Leave entity in place — unload will refuse rather than delete load.
+            }
+        }
+    }
+
+    private static boolean corridorChunkHasNonPlayerEntities(final ServerLevel world, final int cx, final int cz) {
+        final net.minecraft.world.phys.AABB box = new net.minecraft.world.phys.AABB(
+                cx << 4, world.getMinY(), cz << 4,
+                (cx << 4) + 16, world.getMaxY() + 1, (cz << 4) + 16);
+        final List<net.minecraft.world.entity.Entity> found =
+                world.getEntities((net.minecraft.world.entity.Entity) null, box,
+                        e -> !(e instanceof net.minecraft.world.entity.player.Player)
+                                && e.chunkPosition().x() == cx && e.chunkPosition().z() == cz);
+        return !found.isEmpty();
+    }
+
+    /** Only when Bukkit unloaded AND Moonrise has no holder — sync regionizer bitset. */
+    private static void repairRegionizer(final ServerLevel world, final int cx, final int cz) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr =
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) world)
+                            .moonrise$getChunkTaskScheduler().chunkHolderManager;
+            if (mgr.getChunkHolder(cx, cz) != null) {
+                // Holder still present — Moonrise will removeChunk; do not race it.
+                return;
+            }
+            world.regioniser.removeChunk(cx, cz);
+            REGIONIZER_REPAIRS.increment();
+            CHUNKS_UNLOADED.increment();
+        } catch (final IllegalStateException expected) {
+            CHUNKS_UNLOADED.increment();
+        } catch (final Throwable t) {
+            LOGGER.debug("YaP regionizer repair {},{}: {}", cx, cz, t.toString());
+        }
+    }
+
+    private static void stripNonUnknownTickets(final ServerLevel world, final int cx, final int cz) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr =
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) world)
+                            .moonrise$getChunkTaskScheduler().chunkHolderManager;
+            for (int pass = 0; pass < 4; ++pass) {
+                final java.util.List<net.minecraft.server.level.Ticket> tickets =
+                        new java.util.ArrayList<>(mgr.getTicketsAt(cx, cz));
+                if (tickets.isEmpty()) {
+                    return;
+                }
+                boolean progress = false;
+                for (final net.minecraft.server.level.Ticket ticket : tickets) {
+                    if (ticket.getType() == TicketType.UNKNOWN) {
+                        continue;
+                    }
+                    try {
+                        final Object id = ((ca.spottedleaf.moonrise.patches.chunk_system.ticket.ChunkSystemTicket<?>) ticket)
+                                .moonrise$getIdentifier();
+                        mgr.removeTicketAtLevel(ticket.getType(), cx, cz, ticket.getTicketLevel(), id);
+                        progress = true;
+                    } catch (final Throwable ignored) {
+                    }
+                }
+                if (!progress) {
+                    return;
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+    }
+}
