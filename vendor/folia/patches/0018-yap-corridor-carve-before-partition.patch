+    private static final class GapHold {
+        private final ServerLevel world;
+        private final CorridorPlan plan;
+        private final int[] anchor;
+        private final CarveLandings landings;
+        private final AtomicInteger tickCounter = new AtomicInteger();
+
+        private GapHold(final ServerLevel world, final CorridorPlan plan, final int[] anchor,
+                        final CarveLandings landings) {
+            this.world = world;
+            this.plan = plan;
+            this.anchor = anchor;
+            this.landings = landings;
+        }
+    }
+
+    private static void maintainGapBand(final GapHold hold) {
+        final LongOpenHashSet keys = collectCorridorKeysFromWorld(hold.world, hold.plan);
+        if (keys.isEmpty()) {
+            return;
+        }
+        // Anchor outside corridor — never queueTickTaskQueue on gap chunks (pins them).
+        runOnAnchor(hold.world, hold.anchor, 30L, () -> {
+            for (final long key : keys) {
+                final int cx = CoordinateUtils.getChunkX(key);
+                final int cz = CoordinateUtils.getChunkZ(key);
+                if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(hold.world, cx, cz)) {
+                    continue;
+                }
+                try {
+                    hold.world.setChunkForced(cx, cz, false);
+                } catch (final Throwable ignored) {
+                }
+                stripNonUnknownTickets(hold.world, cx, cz);
+                maintainGapChunk(hold, cx, cz);
+            }
+        });
+    }
