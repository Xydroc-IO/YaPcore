+    /**
+     * Collect chunk keys still present in the regionizer for the corridor band.
+     */
+    private static LongOpenHashSet collectCorridorKeysFromWorld(final ServerLevel world, final CorridorPlan plan) {
+        final LongOpenHashSet keys = new LongOpenHashSet();
+        try {
+            world.regioniser.computeForAllRegionsUnsynchronised(region -> {
+                final List<? extends ThreadedRegionizer.ThreadedRegionSection<?, ?>> sections = region.copySections();
+                for (final ThreadedRegionizer.ThreadedRegionSection<?, ?> s : sections) {
+                    if (s.isEmpty()) {
+                        continue;
+                    }
+                    final int coord = plan.cutOnX ? s.sectionX : s.sectionZ;
+                    if (coord < plan.lo || coord > plan.hi) {
+                        continue;
+                    }
+                    final LongArrayList chunks = s.getChunks();
+                    for (int i = 0; i < chunks.size(); ++i) {
+                        keys.add(chunks.getLong(i));
+                    }
+                }
+            });
+        } catch (final Throwable t) {
+            LOGGER.warn("YaP corridor collect remaining failed", t);
+        }
+        return keys;
+    }
