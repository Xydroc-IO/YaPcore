+    static String describeTickets(final ServerLevel world, final int cx, final int cz) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr = holderManager(world);
+            final java.util.List<net.minecraft.server.level.Ticket> tickets = mgr.getTicketsAt(cx, cz);
+            final StringBuilder sb = new StringBuilder();
+            sb.append(cx).append(',').append(cz);
+            if (tickets.isEmpty()) {
+                sb.append("[none]");
+            } else {
+                sb.append('[');
+                for (int i = 0; i < tickets.size(); i++) {
+                    if (i > 0) {
+                        sb.append(';');
+                    }
+                    final net.minecraft.server.level.Ticket t = tickets.get(i);
+                    sb.append(String.valueOf(t.getType())).append('@').append(t.getTicketLevel());
+                }
+                sb.append(']');
+            }
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder holder =
+                    mgr.getChunkHolder(cx, cz);
+            if (holder != null) {
+                String safe = "?";
+                try {
+                    safe = String.valueOf(holder.isSafeToUnload());
+                } catch (final Throwable ignored) {
+                }
+                sb.append(" lvl=").append(holder.getTicketLevel()).append(" safe=").append(safe);
+            } else {
+                sb.append(" holder=null");
+            }
+            return sb.toString();
+        } catch (final Throwable t) {
+            return "err:" + t.toString();
+        }
+    }
+
+    static void stripNonUnknownTickets(final ServerLevel world, final int cx, final int cz) {
+        try {
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager mgr =
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel) world)
+                            .moonrise$getChunkTaskScheduler().chunkHolderManager;
+            for (int pass = 0; pass < 4; ++pass) {
+                final java.util.List<net.minecraft.server.level.Ticket> tickets =
+                        new java.util.ArrayList<>(mgr.getTicketsAt(cx, cz));
+                if (tickets.isEmpty()) {
+                    return;
+                }
+                boolean progress = false;
+                for (final net.minecraft.server.level.Ticket ticket : tickets) {
+                    if (ticket.getType() == TicketType.UNKNOWN) {
+                        continue;
+                    }
+                    try {
+                        final Object id = ((ca.spottedleaf.moonrise.patches.chunk_system.ticket.ChunkSystemTicket<?>) ticket)
+                                .moonrise$getIdentifier();
+                        mgr.removeTicketAtLevel(ticket.getType(), cx, cz, ticket.getTicketLevel(), id);
+                        progress = true;
+                    } catch (final Throwable ignored) {
+                    }
+                }
+                if (!progress) {
+                    return;
+                }
+            }
+        } catch (final Throwable ignored) {
+        }
+    }
