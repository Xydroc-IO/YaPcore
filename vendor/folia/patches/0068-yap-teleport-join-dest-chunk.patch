+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/RegionizedTaskQueue.java
@@ -75,6 +75,19 @@
         return ret;
     }
 
+    /**
+     * Queue onto whichever region currently owns {@code chunkX, chunkZ}.
+     * Does not capture a region data id. Id 0 is the global/unset sentinel
+     * ({@code TickRegionData} ids start at 1). After a split, chunk 0 is not region 0.
+     */
+    public PrioritisedExecutor.PrioritisedTask queueTickTaskByDestinationChunk(final ServerLevel world, final int chunkX, final int chunkZ,
+                                                                              final Runnable run) {
+        final PrioritisedExecutor.PrioritisedTask ret = new PrioritisedQueue.ChunkBasedPriorityTask(
+            world.taskQueueRegionData, chunkX, chunkZ, false, run, Priority.NORMAL);
+        ret.queue();
+        return ret;
+    }
+
     public PrioritisedExecutor.PrioritisedTask queueOrExecuteTickTask(final ServerLevel world, final int chunkX, final int chunkZ,
                                                                       final Runnable run) {
         return this.queueOrExecuteTickTask(world, chunkX, chunkZ, run, Priority.NORMAL);
