+package io.papermc.paper.threadedregions;
+
+/**
+ * Shared per-region-tick MSPT sample for YaP budgets / microtick.
+ * Written from {@link TickRegions} after each region tick; read by entity budget gates.
+ */
+public final class YapHotRegionGate {
+
+    private static final ThreadLocal<Sample> CURRENT = new ThreadLocal<>();
+
+    private YapHotRegionGate() {
+    }
+
+    /** Record MSPT (ms) for the region tick currently completing / about to run entity phase. */
+    public static void noteMspt(final long msptMs) {
+        Sample s = CURRENT.get();
+        if (s == null) {
+            s = new Sample();
+            CURRENT.set(s);
+        }
+        s.msptMs = Math.max(0L, msptMs);
+        s.valid = true;
+    }
+
+    public static void clear() {
+        CURRENT.remove();
+    }
+
+    public static long lastMsptMs() {
+        final Sample s = CURRENT.get();
+        return s != null && s.valid ? s.msptMs : 0L;
+    }
+
+    /**
+     * @param thresholdMs engage when last MSPT ≥ this; {@code ≤0} means always engage when caller enabled
+     */
+    public static boolean hotEnough(final double thresholdMs) {
+        if (thresholdMs <= 0.0) {
+            return true;
+        }
+        return lastMsptMs() >= thresholdMs;
+    }
+
+    private static final class Sample {
+        long msptMs;
+        boolean valid;
+    }
+}
