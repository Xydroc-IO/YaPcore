+                        // Skipping without zeroing leaves the pre-cut propagator level on the
+                        // holder (getTicketsAt empty, lvl=MAX, isSafeToUnload=ticket_level).
+                        // Neighbor view-distance then never lets the Folia empty buffer drop.
+                        if (section != null) {
+                            final short cutStored = section.levels[localIndex];
+                            if ((cutStored & 0xFF) != 0) {
+                                section.levels[localIndex] = (short) (cutStored & ~0xFF);
+                                updatedPositions.putAndMoveToLast(CoordinateUtils.getChunkKey(offX, offZ), (byte) 0);
+                            }
+                        }
                         continue;
                     }
 
