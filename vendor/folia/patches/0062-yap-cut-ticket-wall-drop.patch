+    /**
+     * View-distance can load more cut-axis chunks after evacuate. Those are a real
+     * west–east bridge — absorb them into the hole and unload (relocate, not delete).
+     * Does not widen the cut axis into kept-edge spawn.
+     *
+     * @return newly added keys
+     */
+    public static int absorbCutAxisKeys(
+            final ServerLevel world,
+            final YapCorridorCarver.CorridorPlan plan,
+            final LongOpenHashSet loaded) {
+        if (!ENABLED || world == null || plan == null || loaded == null || loaded.isEmpty()) {
+            return 0;
+        }
+        final ConcurrentHashMap<Long, Cut> worldCuts = BY_WORLD.get(System.identityHashCode(world));
+        if (worldCuts == null || worldCuts.isEmpty()) {
+            return 0;
+        }
+        final int shift = TickRegions.getRegionChunkShift();
+        int added = 0;
+        final LongIterator it = loaded.longIterator();
+        while (it.hasNext()) {
+            final long chunkKey = it.nextLong();
+            final int sx = CoordinateUtils.getChunkX(chunkKey) >> shift;
+            final int sz = CoordinateUtils.getChunkZ(chunkKey) >> shift;
+            final int axis = plan.cutOnX() ? sx : sz;
+            if (axis < plan.lo() || axis > plan.hi()) {
+                continue;
+            }
+            for (final Cut cut : worldCuts.values()) {
+                if (cut.cutOnX != plan.cutOnX()) {
+                    continue;
+                }
+                if (cut.includeCutAxisSection(sx, sz) && cut.chunks.add(chunkKey)) {
+                    added++;
+                    plan.keys().add(chunkKey);
+                }
+            }
+        }
+        if (added > 0) {
+            LOGGER.info("YaP regionizer gap absorbed {} cut-axis keys (hole grew, still must empty)", added);
+        }
+        return added;
     }
 
