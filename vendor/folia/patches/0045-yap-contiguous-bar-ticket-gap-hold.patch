+    /**
+     * Neighbor sim-distance keeps a stored propagator level on a registered cut even when
+     * {@code getTicketsAt} is empty. Push the holder onto the unload path; {@code processLevelUpdates}
+     * then refuses to recreate it.
+     */
+    public void unloadIfCut(final int chunkX, final int chunkZ) {
+        final long key = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+        final NewChunkHolder current = this.chunkHolders.get(key);
+        if (current == null) {
+            this.updateTicketLevel(key, MAX_TICKET_LEVEL + 1);
+            return;
+        }
+        final int rad = 2 * ChunkTaskScheduler.getMaxAccessRadius();
+        final List<ChunkProgressionTask> scheduledTasks = new ArrayList<>();
+        final List<NewChunkHolder> changedFullStatus = new ArrayList<>();
+        final ReentrantAreaLock.Node ticketLock = this.ticketLockArea.lock(chunkX, chunkZ);
+        try {
+            this.updateTicketLevel(key, MAX_TICKET_LEVEL + 1);
+            current.updateTicketLevel(MAX_TICKET_LEVEL + 1);
+            final List<ChunkProgressionTask> prev = CURRENT_TICKET_UPDATE_SCHEDULING.get();
+            CURRENT_TICKET_UPDATE_SCHEDULING.set(scheduledTasks);
+            final ReentrantAreaLock.Node schedulingNode = this.taskScheduler.schedulingLockArea.lock(
+                    chunkX - rad, chunkZ - rad, chunkX + rad, chunkZ + rad);
+            try {
+                current.processTicketLevelUpdate(scheduledTasks, changedFullStatus);
+            } finally {
+                this.taskScheduler.schedulingLockArea.unlock(schedulingNode);
+                CURRENT_TICKET_UPDATE_SCHEDULING.set(prev);
+            }
+        } finally {
+            this.ticketLockArea.unlock(ticketLock);
+        }
+        this.addChangedStatuses(changedFullStatus);
+        for (int i = 0, len = scheduledTasks.size(); i < len; ++i) {
+            scheduledTasks.get(i).schedule();
         }
     }
 
