+    public static boolean isCutChunk(final ServerLevel world, final int chunkX, final int chunkZ) {
+        if (!ENABLED || world == null) {
+            return false;
+        }
+        final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+        final int shift = TickRegions.getRegionChunkShift();
+        final int sectionX = chunkX >> shift;
+        final int sectionZ = chunkZ >> shift;
+        final ConcurrentHashMap<Long, Cut> worldCuts = BY_WORLD.get(System.identityHashCode(world));
+        if (worldCuts != null && chunkInCuts(worldCuts, chunkKey, sectionX, sectionZ)) {
+            return true;
+        }
+        // identityHashCode can miss if register used a different ServerLevel instance
+        for (final ConcurrentHashMap<Long, Cut> cuts : BY_WORLD.values()) {
+            if (cuts != worldCuts && chunkInCuts(cuts, chunkKey, sectionX, sectionZ)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean chunkInCuts(final ConcurrentHashMap<Long, Cut> worldCuts,
+                                       final long chunkKey, final int sectionX, final int sectionZ) {
+        if (worldCuts == null || worldCuts.isEmpty()) {
+            return false;
+        }
+        for (final Cut cut : worldCuts.values()) {
+            if (cut.chunks.contains(chunkKey) || cut.containsSection(sectionX, sectionZ)) {
+                return true;
+            }
+        }
+        return false;
+    }
