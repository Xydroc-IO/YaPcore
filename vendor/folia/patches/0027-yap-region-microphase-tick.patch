+        // YaP — micro-phase BLOCK_ENTITIES complete
+        io.papermc.paper.threadedregions.YapAlignedMicroTicks.finishPhase(io.papermc.paper.threadedregions.YapMicroPhase.BLOCK_ENTITIES);
+        } finally { // YaP - aligned micro/sub-ticks
+            io.papermc.paper.threadedregions.YapAlignedMicroTicks.endRegionTick();
+        } // YaP - aligned micro/sub-ticks
     }
 
