From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP region micro-phase tick split (full ServerLevel phases)

Subdivide ServerLevel#region tick into YapMicroPhase slices with soft wave barriers.
Post-applyAllPatches.
---
--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapAlignedMicroTicks.java
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapAlignedMicroTicks.java
@@ -0,0 +1,106 @@
+package io.papermc.paper.threadedregions;
+
+/**
+ * Product facade for aligned cross-region micro/sub-ticks (B + full).
+ *
+ * <p>When {@code -Dyap.folia.aligned-microticks=true}, each logical region tick is subdivided into
+ * {@link YapMicroPhase} slices with soft epoch-wave barriers and phase-tagged cross-region drains.
+ * Game time still advances once per region tick (not a faster clock).
+ *
+ * <p>When disabled, all entry points no-op and Folia keeps its single-pass tick path.
+ */
+public final class YapAlignedMicroTicks {
+
+    private static final ThreadLocal<RegionTickCtx> CTX = new ThreadLocal<>();
+
+    private YapAlignedMicroTicks() {
+    }
+
+    public static boolean enabled() {
+        return Boolean.parseBoolean(System.getProperty("yap.folia.aligned-microticks", "false"));
+    }
+
+    public static RegionTickCtx currentCtx() {
+        return CTX.get();
+    }
+
+    public static YapMicroPhase currentPhase() {
+        final RegionTickCtx ctx = CTX.get();
+        return ctx == null ? YapMicroPhase.CHUNKS : ctx.phase;
+    }
+
+    public static void beginRegionTick(final TickRegions.TickRegionData regionData) {
+        if (!enabled() || regionData == null) {
+            return;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("YaP aligned microtick begin");
+        final long epoch = YapTickEpochCoordinator.wallEpoch();
+        YapTickEpochCoordinator.scrubStaleWaves(epoch);
+        YapTickEpochCoordinator.awaitPhaseOpen(epoch, YapMicroPhase.CHUNKS);
+        final RegionTickCtx ctx = new RegionTickCtx();
+        ctx.regionDataId = regionData.id;
+        ctx.epoch = epoch;
+        ctx.phase = YapMicroPhase.CHUNKS.collapseToConfigured();
+        CTX.set(ctx);
+        YapPhaseTaggedTasks.drainForCurrentPhase();
+    }
+
+    /**
+     * Finish {@code completed} work, soft-barrier to the next phase, then drain tagged tasks.
+     * No-op when disabled or when {@code completed} is not the active phase (collapsed configs).
+     */
+    public static void finishPhase(final YapMicroPhase completed) {
+        if (!enabled()) {
+            return;
+        }
+        final RegionTickCtx ctx = CTX.get();
+        if (ctx == null) {
+            return;
+        }
+        final YapMicroPhase logical = completed.collapseToConfigured();
+        if (ctx.phase != logical) {
+            // Collapsed phase count: skip duplicate barrier for phases merged away.
+            return;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("YaP aligned microtick phase");
+        final YapMicroPhase next = logical.next();
+        if (next == null || logical == YapMicroPhase.lastConfigured()) {
+            YapTickEpochCoordinator.arrive(ctx.epoch, logical);
+            return;
+        }
+        final YapMicroPhase nextConfigured = next.collapseToConfigured();
+        if (nextConfigured == logical) {
+            YapTickEpochCoordinator.arrive(ctx.epoch, logical);
+            return;
+        }
+        YapTickEpochCoordinator.arriveAndAwaitNext(ctx.epoch, logical);
+        ctx.phase = nextConfigured;
+        YapPhaseTaggedTasks.drainForCurrentPhase();
+    }
+
+    public static void endRegionTick() {
+        if (!enabled()) {
+            CTX.remove();
+            return;
+        }
+        final RegionTickCtx ctx = CTX.get();
+        if (ctx != null) {
+            ctx.phase = YapMicroPhase.lastConfigured();
+            YapPhaseTaggedTasks.drainForCurrentPhase();
+            YapTickEpochCoordinator.arrive(ctx.epoch, ctx.phase);
+        }
+        CTX.remove();
+    }
+
+    public static long regionDataIdOrZero() {
+        final RegionTickCtx ctx = CTX.get();
+        return ctx == null ? 0L : ctx.regionDataId;
+    }
+}
+
+/** Per-tick-thread state for aligned microticks. */
+final class RegionTickCtx {
+    long regionDataId;
+    long epoch;
+    YapMicroPhase phase;
+}
