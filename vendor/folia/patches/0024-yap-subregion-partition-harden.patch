+package io.papermc.paper.threadedregions;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Spatial cut helpers for {@link YapSubRegionPartitioner} (kept separate for ≤500-line domain files).
+ */
+final class YapSubRegionCuts {
+
+    private YapSubRegionCuts() {
+    }
+
+    /**
+     * Spatial cut: K=2 median X (fallback Z); K=3 X tertiles; K=4 median X then Z.
+     * Prefers a cut index where both sides of the boundary are empty sections.
+     */
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> cutSections(
+            final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sections,
+            final int k) {
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted = new ArrayList<>(sections);
+        sorted.sort(Comparator
+                .comparingInt((ThreadedRegionizer.ThreadedRegionSection<R, S> s) -> s.sectionX)
+                .thenComparingInt(s -> s.sectionZ));
+
+        final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> out = new ArrayList<>();
+        if (k <= 2 || sorted.size() < 4) {
+            final boolean sameX = sorted.get(0).sectionX == sorted.get(sorted.size() - 1).sectionX;
+            if (sameX) {
+                sorted.sort(Comparator.comparingInt(s -> s.sectionZ));
+            }
+            final int mid = preferEmptyCut(sorted, sorted.size() / 2);
+            if (mid < 0) {
+                return out;
+            }
+            out.add(new ArrayList<>(sorted.subList(0, Math.max(1, mid))));
+            out.add(new ArrayList<>(sorted.subList(Math.max(1, mid), sorted.size())));
+            return out;
+        }
+        if (k == 3) {
+            final int a = preferEmptyCut(sorted, sorted.size() / 3);
+            final int b = preferEmptyCut(sorted, (2 * sorted.size()) / 3);
+            if (a < 0 || b < 0) {
+                return out;
+            }
+            final int cutA = Math.max(1, a);
+            final int cutB = Math.max(cutA + 1, b);
+            out.add(new ArrayList<>(sorted.subList(0, cutA)));
+            out.add(new ArrayList<>(sorted.subList(cutA, cutB)));
+            out.add(new ArrayList<>(sorted.subList(cutB, sorted.size())));
+            return out;
+        }
+        final int midX = preferEmptyCut(sorted, sorted.size() / 2);
+        if (midX < 0) {
+            return out;
+        }
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> left =
+                new ArrayList<>(sorted.subList(0, Math.max(1, midX)));
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> right =
+                new ArrayList<>(sorted.subList(Math.max(1, midX), sorted.size()));
+        if (!splitByZ(left, out) || !splitByZ(right, out)) {
+            out.clear();
+        }
+        return out;
+    }
+
+    /** Median cut without empty-buffer requirement — used only to plan corridor carve. */
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> cutSectionsAggressive(
+            final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sections,
+            final int k) {
+        final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted = new ArrayList<>(sections);
+        sorted.sort(Comparator
+                .comparingInt((ThreadedRegionizer.ThreadedRegionSection<R, S> s) -> s.sectionX)
+                .thenComparingInt(s -> s.sectionZ));
+        final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> out = new ArrayList<>();
+        if (sorted.size() < 2) {
+            return out;
+        }
+        final boolean sameX = sorted.get(0).sectionX == sorted.get(sorted.size() - 1).sectionX;
+        if (sameX) {
+            sorted.sort(Comparator.comparingInt(s -> s.sectionZ));
+        }
+        final int shards = Math.min(Math.max(2, k), sorted.size());
+        if (shards <= 2) {
+            final int mid = Math.max(1, Math.min(sorted.size() - 1, sorted.size() / 2));
+            out.add(new ArrayList<>(sorted.subList(0, mid)));
+            out.add(new ArrayList<>(sorted.subList(mid, sorted.size())));
+            return out;
+        }
+        final int step = sorted.size() / shards;
+        int prev = 0;
+        for (int i = 1; i < shards; ++i) {
+            final int cut = Math.max(prev + 1, Math.min(sorted.size() - (shards - i), i * step));
+            out.add(new ArrayList<>(sorted.subList(prev, cut)));
+            prev = cut;
+        }
+        out.add(new ArrayList<>(sorted.subList(prev, sorted.size())));
+        return out;
+    }
+
+    /**
+     * Folia-safe: non-empty sections of different shard groups must be farther apart than
+     * {@code 2 × emptySectionCreateRadius} (Chebyshev).
+     */
+    static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    boolean groupsAreSpatiallyBuffered(final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> groups) {
+        final int createRadius = groups.get(0).get(0).regioniser.emptySectionCreateRadius;
+        final int minChebyshev = 2 * Math.max(1, createRadius) + 1;
+        final List<List<int[]>> nonEmpty = new ArrayList<>(groups.size());
+        for (final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> group : groups) {
+            final List<int[]> coords = new ArrayList<>();
+            for (final ThreadedRegionizer.ThreadedRegionSection<R, S> s : group) {
+                if (!s.isEmpty()) {
+                    coords.add(new int[]{s.sectionX, s.sectionZ});
+                }
+            }
+            if (coords.isEmpty()) {
+                return false;
+            }
+            nonEmpty.add(coords);
+        }
+        for (int i = 0; i < nonEmpty.size(); ++i) {
+            for (int j = i + 1; j < nonEmpty.size(); ++j) {
+                for (final int[] a : nonEmpty.get(i)) {
+                    for (final int[] b : nonEmpty.get(j)) {
+                        final int dx = Math.abs(a[0] - b[0]);
+                        final int dz = Math.abs(a[1] - b[1]);
+                        if (Math.max(dx, dz) < minChebyshev) {
+                            return false;
+                        }
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    int preferEmptyCut(final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted, final int preferred) {
+        final int size = sorted.size();
+        if (size < 2) {
+            return -1;
+        }
+        final int lo = 1;
+        final int hi = size - 1;
+        final int start = Math.min(hi, Math.max(lo, preferred));
+        final int maxDrift = Math.max(2, size / 6);
+        for (int d = 0; d <= maxDrift; ++d) {
+            final int left = start - d;
+            final int right = start + d;
+            if (left >= lo && left <= hi && isEmptySidedCut(sorted, left)) {
+                return left;
+            }
+            if (d != 0 && right >= lo && right <= hi && isEmptySidedCut(sorted, right)) {
+                return right;
+            }
+        }
+        return -1;
+    }
+
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    boolean isEmptySidedCut(final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> sorted, final int cut) {
+        return sorted.get(cut - 1).isEmpty() && sorted.get(cut).isEmpty();
+    }
+
+    private static <R extends ThreadedRegionizer.ThreadedRegionData<R, S>, S extends ThreadedRegionizer.ThreadedRegionSectionData>
+    boolean splitByZ(
+            final List<ThreadedRegionizer.ThreadedRegionSection<R, S>> in,
+            final List<List<ThreadedRegionizer.ThreadedRegionSection<R, S>>> out) {
+        if (in.isEmpty()) {
+            return false;
+        }
+        if (in.size() == 1) {
+            out.add(in);
+            return true;
+        }
+        in.sort(Comparator.comparingInt(s -> s.sectionZ));
+        final int mid = preferEmptyCut(in, in.size() / 2);
+        if (mid < 0) {
+            return false;
+        }
+        out.add(new ArrayList<>(in.subList(0, mid)));
+        out.add(new ArrayList<>(in.subList(mid, in.size())));
+        return true;
+    }
+}
