             }
+            // Unloaded rim pads must not be chosen — getChunk(load) / spawn-find deadlocks.
+            if (world.getChunkIfLoaded(dest[0], dest[1]) == null) {
+                continue;
+            }
+            return dest;
         }
         return null;
     }
