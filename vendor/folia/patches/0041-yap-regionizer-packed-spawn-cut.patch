+package io.papermc.paper.threadedregions;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.level.TicketType;
+
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * First-class empty-buffer cut in {@link ThreadedRegionizer}. Stock Folia (and Canvas)
+ * cannot split a packed spawn: {@code addChunk} creates empty neighbour sections and
+ * merge BFS jumps them, while PLAYER/sim tickets refill the hole.
+ *
+ * <p>While a corridor is registered, skip empty-section create, do not BFS across the
+ * band, and refuse tickets that would reload it (players standing in the band keep
+ * their own chunk).
+ *
+ * <p>Keys: negative = in-flight carve ({@code -regionId}); positive = post-partition
+ * shard group. Regionizer write lock for topology; ticket lock for {@link #blocksTicket}.
+ */
+public final class YapRegionizerGap {
+
+    private static final boolean ENABLED = Boolean.parseBoolean(
+            System.getProperty("yap.folia.regionizer-cut", "true"));
+    private static final boolean THIN_GAP = Boolean.parseBoolean(
+            System.getProperty("yap.folia.regionizer-thin-gap", "true"));
+
+    private static final ConcurrentHashMap<Long, Cut> BY_KEY = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<Integer, ConcurrentHashMap<Long, Cut>> BY_WORLD =
+            new ConcurrentHashMap<>();
+    private static final LongAdder TICKETS_CLAMPED = new LongAdder();
+    private static final LongAdder EMPTY_CREATE_SKIPPED = new LongAdder();
+    private static final LongAdder BFS_SKIPPED = new LongAdder();
+
+    private YapRegionizerGap() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    public static boolean thinGap() {
+        return ENABLED && THIN_GAP;
+    }
+
+    public static int minChebyshev(final int createRadius) {
+        final int r = Math.max(1, createRadius);
+        return thinGap() ? r + 1 : 2 * r + 1;
+    }
+
+    public static void register(final ServerLevel world,
+                                final YapCorridorCarver.CorridorPlan plan,
+                                final long key) {
+        if (!ENABLED || world == null || plan == null || plan.keys().isEmpty() || key == 0L) {
+            return;
+        }
+        final int worldId = System.identityHashCode(world);
+        final Cut cut = new Cut(worldId, plan.cutOnX(), plan.lo(), plan.hi());
+        BY_KEY.put(key, cut);
+        BY_WORLD.computeIfAbsent(worldId, w -> new ConcurrentHashMap<>()).put(key, cut);
+    }
+
+    public static void release(final long key) {
+        if (key == 0L) {
+            return;
+        }
+        final Cut cut = BY_KEY.remove(key);
+        if (cut == null) {
+            return;
+        }
+        final ConcurrentHashMap<Long, Cut> worldCuts = BY_WORLD.get(cut.worldId);
+        if (worldCuts != null) {
+            worldCuts.remove(key);
+            if (worldCuts.isEmpty()) {
+                BY_WORLD.remove(cut.worldId, worldCuts);
+            }
+        }
+    }
+
+    public static boolean blocksAddChunk(final ServerLevel world, final int chunkX, final int chunkZ) {
+        if (!ENABLED || world == null) {
+            return false;
+        }
+        final int shift = TickRegions.getRegionChunkShift();
+        if (find(world, chunkX >> shift, chunkZ >> shift) == null) {
+            return false;
+        }
+        return !playerInChunk(world, chunkX, chunkZ);
+    }
+
+    public static boolean blocksSection(final ThreadedRegionizer<?, ?> regionizer, final int sectionX, final int sectionZ) {
+        if (!ENABLED || regionizer == null) {
+            return false;
+        }
+        return find(regionizer.world, sectionX, sectionZ) != null;
+    }
+
+    public static boolean blocksEmptySection(final ServerLevel world, final int sectionX, final int sectionZ) {
+        if (!ENABLED || world == null || find(world, sectionX, sectionZ) == null) {
+            return false;
+        }
+        EMPTY_CREATE_SKIPPED.increment();
+        return true;
+    }
+
+    public static boolean isCutSection(final ServerLevel world, final int sectionX, final int sectionZ) {
+        return ENABLED && world != null && find(world, sectionX, sectionZ) != null;
+    }
+
+    public static boolean separates(final ServerLevel world,
+                                    final int ax, final int az, final int bx, final int bz) {
+        if (!ENABLED || world == null) {
+            return false;
+        }
+        final ConcurrentHashMap<Long, Cut> worldCuts = BY_WORLD.get(System.identityHashCode(world));
+        if (worldCuts == null || worldCuts.isEmpty()) {
+            return false;
+        }
