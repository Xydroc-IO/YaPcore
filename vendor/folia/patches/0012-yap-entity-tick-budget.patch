+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * YaP Phase 3.2 — per-region entity tick budget for spawn-collapse / hot regions.
+ *
+ * <p>{@code -Dyap.folia.entity-tick-budget=N} — max entities ticked per region tick
+ * (0 / unset = unlimited). Players are never skipped.
+ */
+public final class YapEntityTickBudget {
+
+    private static final ThreadLocal<Counter> CURRENT = new ThreadLocal<>();
+    private static final AtomicLong SKIPPED = new AtomicLong();
+
+    private YapEntityTickBudget() {
+    }
+
+    public static int budget() {
+        return Integer.getInteger("yap.folia.entity-tick-budget", 0);
+    }
+
+    public static boolean enabled() {
+        return budget() > 0;
+    }
+
+    public static void beginTick() {
+        if (!enabled()) {
+            return;
+        }
+        Counter c = CURRENT.get();
+        if (c == null) {
+            c = new Counter();
+            CURRENT.set(c);
+        }
+        c.ticked = 0;
+        c.limit = budget();
+    }
+
+    public static void endTick() {
+        CURRENT.remove();
+    }
+
+    /**
+     * @param entity entity under consideration
+     * @return true if this entity should be ticked; false to skip for this tick
+     */
+    public static boolean allowTick(final net.minecraft.world.entity.Entity entity) {
+        if (!enabled()) {
+            return true;
+        }
+        // Always tick players, TNT, vehicles, items — budget only AI mobs.
+        if (entity instanceof net.minecraft.world.entity.player.Player
+                || entity instanceof net.minecraft.world.entity.item.PrimedTnt
+                || entity instanceof net.minecraft.world.entity.vehicle.VehicleEntity
+                || entity instanceof net.minecraft.world.entity.vehicle.minecart.AbstractMinecart
+                || entity instanceof net.minecraft.world.entity.item.ItemEntity
+                || entity instanceof net.minecraft.world.entity.ExperienceOrb
+                || !(entity instanceof net.minecraft.world.entity.Mob)) {
+            return true;
+        }
+        final Counter c = CURRENT.get();
+        if (c == null) {
+            return true;
+        }
+        if (c.ticked >= c.limit) {
+            SKIPPED.incrementAndGet();
+            return false;
+        }
+        c.ticked++;
+        return true;
+    }
+
+    /** @deprecated use {@link #allowTick(net.minecraft.world.entity.Entity)} */
+    @Deprecated
+    public static boolean allowTick(final boolean isPlayer) {
+        if (!enabled() || isPlayer) {
+            return true;
+        }
+        final Counter c = CURRENT.get();
+        if (c == null) {
+            return true;
+        }
+        if (c.ticked >= c.limit) {
+            SKIPPED.incrementAndGet();
+            return false;
+        }
+        c.ticked++;
+        return true;
+    }
+
+    public static long skippedCount() {
+        return SKIPPED.get();
+    }
+
+    private static final class Counter {
+        int ticked;
+        int limit;
+    }
+}
