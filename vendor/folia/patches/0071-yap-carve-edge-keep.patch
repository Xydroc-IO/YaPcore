+    /**
+     * First air block above a motion-blocking column, or {@link Integer#MIN_VALUE}
+     * when the chunk is unloaded or the column has no floor. Do not land there.
+     */
+    static int motionFloorY(final ServerLevel world, final int chunkX, final int chunkZ) {
+        if (world.getChunkIfLoaded(chunkX, chunkZ) == null) {
+            return Integer.MIN_VALUE;
+        }
+        try {
+            final int h = world.getHeight(
+                    net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING,
+                    (chunkX << 4) + 8, (chunkZ << 4) + 8);
+            return h > world.getMinY() ? h : Integer.MIN_VALUE;
+        } catch (final Throwable ignored) {
+            return Integer.MIN_VALUE;
+        }
+    }
