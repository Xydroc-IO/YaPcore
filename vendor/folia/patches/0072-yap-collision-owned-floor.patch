--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapRegionizerGap.java
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapRegionizerGap.java
@@ -155,6 +155,49 @@
     }
 
     /**
+     * This thread may read the chunk's real block shapes. Radius-4 ownership
+     * fails when the halo reaches the carved corridor. That section is empty,
+     * not another shard. Treating the owned chunk as a foreign box drops
+     * entities that are already inside it — collideY does not stop a fall
+     * through a box the entity already overlaps.
+     */
+    public static boolean collisionOwnsChunk(
+            final net.minecraft.world.level.Level world, final int chunkX, final int chunkZ, final int radius) {
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(world, chunkX, chunkZ, radius)) {
+            return true;
+        }
+        if (!(world instanceof ServerLevel serverLevel)) {
+            return false;
+        }
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(serverLevel, chunkX, chunkZ)) {
+            return false;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+                TickRegionScheduler.getCurrentRegion();
+        if (region == null) {
+            return false;
+        }
+        final int shift = serverLevel.regioniser.sectionChunkShift;
+        final int minSectionX = (chunkX - radius) >> shift;
+        final int maxSectionX = (chunkX + radius) >> shift;
+        final int minSectionZ = (chunkZ - radius) >> shift;
+        final int maxSectionZ = (chunkZ + radius) >> shift;
+        for (int secZ = minSectionZ; secZ <= maxSectionZ; ++secZ) {
+            for (int secX = minSectionX; secX <= maxSectionX; ++secX) {
+                final int lowerLeftX = secX << shift;
+                final int lowerLeftZ = secZ << shift;
+                if (serverLevel.regioniser.getRegionAtUnsynchronised(lowerLeftX, lowerLeftZ) == region) {
+                    continue;
+                }
+                if (!isCutChunk(serverLevel, lowerLeftX, lowerLeftZ)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
