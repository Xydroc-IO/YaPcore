+/**
+ * YaP Phase 3.4 — restore Folia-disabled scoreboard mutations behind SWMR lock.
+ *
+ * <p>Gated by {@code -Dyap.folia.scoreboard-swmr=true} (default false).
+ * Writers take the write lock; readers are unchanged (existing Folia read paths).
+ */
+public final class YapScoreboardSwmr {
+
+    private static final ReentrantReadWriteLock LOCK = new ReentrantReadWriteLock();
+
+    private YapScoreboardSwmr() {
+    }
+
+    public static boolean enabled() {
+        return Boolean.parseBoolean(System.getProperty("yap.folia.scoreboard-swmr", "false"));
+    }
+
+    /** @return true if mutations are allowed (flag on); caller must still use {@link #writeLock} */
+    public static boolean allowMutation() {
+        return enabled();
+    }
+
+    public static void writeLock() {
+        LOCK.writeLock().lock();
+    }
+
+    public static void writeUnlock() {
+        LOCK.writeLock().unlock();
+    }
+}
