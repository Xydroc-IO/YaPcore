+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+
+/**
+ * YaP regionizer telemetry — merge/split, active regions, and tick-thread migrations
+ * (approximation of work-steals when {@code WORK_STEALING} is enabled).
+ *
+ * <p>Knobs (system properties):
+ * <ul>
+ *   <li>{@code -Dyap.folia.region-metrics=true} — enable counters (default true)</li>
+ * </ul>
+ */
+public final class YapRegionPoolMetrics {
+
+    private static final boolean ENABLED = !"false".equalsIgnoreCase(
+            System.getProperty("yap.folia.region-metrics", "true"));
+
+    private static final LongAdder MERGES = new LongAdder();
+    private static final LongAdder SPLITS = new LongAdder();
+    private static final LongAdder REGION_ACTIVE = new LongAdder();
+    private static final LongAdder REGION_INACTIVE = new LongAdder();
+    private static final LongAdder TICK_MIGRATIONS = new LongAdder();
+    private static final LongAdder TICKS = new LongAdder();
+    private static final AtomicLong ACTIVE_REGIONS = new AtomicLong();
+
+    /** region id → last tick thread id */
+    private static final ConcurrentHashMap<Long, Long> LAST_TICK_THREAD = new ConcurrentHashMap<>();
+
+    private YapRegionPoolMetrics() {
+    }
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    public static void onRegionActive() {
+        if (!ENABLED) {
+            return;
+        }
+        REGION_ACTIVE.increment();
+        ACTIVE_REGIONS.incrementAndGet();
+    }
+
+    public static void onRegionInactive() {
+        if (!ENABLED) {
+            return;
+        }
+        REGION_INACTIVE.increment();
+        ACTIVE_REGIONS.updateAndGet(v -> Math.max(0, v - 1));
+    }
+
+    public static void onMerge() {
+        if (ENABLED) {
+            MERGES.increment();
+        }
+    }
+
+    public static void onSplit(final int intoCount) {
+        if (ENABLED) {
+            SPLITS.increment();
+        }
+    }
+
+    /**
+     * Record a region tick start. If the same region runs on a different thread than
+     * last time, count a migration (steal / rebalance signal under WORK_STEALING).
+     */
+    public static void onRegionTick(final long regionId, final long threadId) {
+        if (!ENABLED) {
+            return;
+        }
+        TICKS.increment();
+        final Long prev = LAST_TICK_THREAD.put(regionId, threadId);
+        if (prev != null && prev.longValue() != threadId) {
+            TICK_MIGRATIONS.increment();
+        }
+    }
+
+    public static long merges() {
+        return MERGES.sum();
+    }
+
+    public static long splits() {
+        return SPLITS.sum();
+    }
+
+    public static long regionActiveEvents() {
+        return REGION_ACTIVE.sum();
+    }
+
+    public static long regionInactiveEvents() {
+        return REGION_INACTIVE.sum();
+    }
+
+    public static long tickMigrations() {
+        return TICK_MIGRATIONS.sum();
+    }
+
+    public static long ticks() {
+        return TICKS.sum();
+    }
+
+    public static long activeRegions() {
+        return ACTIVE_REGIONS.get();
+    }
+
+    public static String snapshot() {
+        return "active=" + activeRegions()
+                + " ticks=" + ticks()
+                + " migrations=" + tickMigrations()
+                + " merges=" + merges()
+                + " splits=" + splits()
+                + " activeEv=" + regionActiveEvents()
+                + " inactiveEv=" + regionInactiveEvents();
+    }
+}
