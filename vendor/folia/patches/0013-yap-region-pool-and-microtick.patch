+package io.papermc.paper.threadedregions;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * YaP sub-tick / micro-tick time-slice for hot regions.
+ *
+ * <p>Folia cannot run multiple tick threads inside one region (ownership invariant).
+ * This approximates sub-ticking by <strong>time-slicing</strong> the entity AI phase
+ * within a single region tick — remaining mobs are deferred to later ticks.
+ *
+ * <p>Knobs:
+ * <ul>
+ *   <li>{@code -Dyap.folia.microtick-budget-ms=N} — soft deadline for Mob AI phase (0=off)</li>
+ *   <li>Works together with {@link YapEntityTickBudget} count budget</li>
+ * </ul>
+ */
+public final class YapMicroTick {
+
+    private static final ThreadLocal<Deadline> CURRENT = new ThreadLocal<>();
+    private static final AtomicLong TIME_SKIPS = new AtomicLong();
+
+    private YapMicroTick() {
+    }
+
+    public static int budgetMs() {
+        return Integer.getInteger("yap.folia.microtick-budget-ms", 0);
+    }
+
+    public static boolean enabled() {
+        return budgetMs() > 0;
+    }
+
+    public static void beginEntityPhase() {
+        if (!enabled()) {
+            return;
+        }
+        Deadline d = CURRENT.get();
+        if (d == null) {
+            d = new Deadline();
+            CURRENT.set(d);
+        }
+        d.deadlineNs = System.nanoTime() + budgetMs() * 1_000_000L;
+        d.exhausted = false;
+    }
+
+    public static void endEntityPhase() {
+        CURRENT.remove();
+    }
+
+    /** @return false when the soft deadline has elapsed (skip remaining Mob AI) */
+    public static boolean allowMoreWork() {
+        if (!enabled()) {
+            return true;
+        }
+        final Deadline d = CURRENT.get();
+        if (d == null || d.exhausted) {
+            if (d != null && d.exhausted) {
+                return false;
+            }
+            return true;
+        }
+        if (System.nanoTime() >= d.deadlineNs) {
+            d.exhausted = true;
+            TIME_SKIPS.incrementAndGet();
+            return false;
+        }
+        return true;
+    }
+
+    public static long timeSkipEvents() {
+        return TIME_SKIPS.get();
+    }
+
+    private static final class Deadline {
+        long deadlineNs;
+        boolean exhausted;
+    }
+}
