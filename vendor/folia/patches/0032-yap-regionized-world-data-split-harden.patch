From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP RegionizedWorldData split/merge harden

Null-safe split of connections, players, block-entities, and chunk lists.
0016 already guards entity redistribution; this covers the remaining
Folia "impossible get() is null" paths that force-partition can still hit,
plus null ticking-block-entity pos on split/merge.
Post-applyAllPatches. Depends on 0016.
---
--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapRegionSplit.java
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapRegionSplit.java
@@ -0,0 +1,61 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import com.mojang.logging.LogUtils;
+import it.unimi.dsi.fastutil.longs.Long2ReferenceOpenHashMap;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.entity.TickingBlockEntity;
+import org.slf4j.Logger;
+
+import javax.annotation.Nullable;
+
+/**
+ * Split/merge guards for {@link RegionizedWorldData}. Folia assumes every live entity/chunk
+ * maps to a target region; YaP force-partition can race mid-spawn / sleeping tickers.
+ */
+public final class YapRegionSplit {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private YapRegionSplit() {
+    }
+
+    @Nullable
+    public static RegionizedWorldData target(
+            final Long2ReferenceOpenHashMap<RegionizedWorldData> regionToData,
+            final int chunkX,
+            final int chunkZ,
+            final int chunkToRegionShift,
+            final String what,
+            final Object detail) {
+        final RegionizedWorldData into = regionToData.get(
+                CoordinateUtils.getChunkKey(chunkX >> chunkToRegionShift, chunkZ >> chunkToRegionShift));
+        if (into != null) {
+            return into;
+        }
+        LOGGER.error(
+                "YaP region split: no target RegionizedWorldData for {} {} at chunk {},{} — keeping on source until next merge",
+                what,
+                detail,
+                chunkX,
+                chunkZ);
+        return null;
+    }
+
+    @Nullable
+    public static BlockPos posOrNull(final TickingBlockEntity ticker, final String list) {
+        if (ticker == null) {
+            LOGGER.error("YaP region split/merge: null {} ticker — keeping on source", list);
+            return null;
+        }
+        final BlockPos pos = ticker.getPos();
+        if (pos != null) {
+            return pos;
+        }
+        LOGGER.error(
+                "YaP region split: {} ticker {} has null pos — keeping on source until next merge",
+                list,
+                ticker.getClass().getName());
+        return null;
+    }
+}
