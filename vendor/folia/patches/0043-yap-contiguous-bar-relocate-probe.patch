+    /** Non-empty overworld regions — professional bar: shards still independent after the cut. */
+    private static int tickingRegions() {
+        final ServerLevel level = overworld();
+        if (level == null) {
+            return 0;
+        }
+        final java.util.concurrent.atomic.AtomicInteger n = new java.util.concurrent.atomic.AtomicInteger();
+        try {
+            level.regioniser.computeForAllRegionsUnsynchronised(region -> {
+                for (final ThreadedRegionizer.ThreadedRegionSection<?, ?> section : region.copySections()) {
+                    if (!section.isEmpty()) {
+                        n.incrementAndGet();
+                        return;
+                    }
+                }
+            });
+        } catch (final Throwable ignored) {
+        }
+        return n.get();
+    }
+
