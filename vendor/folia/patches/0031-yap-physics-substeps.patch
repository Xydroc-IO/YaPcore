From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP physics sub-steps (movement/combat)

Internal N-step travel + collision subdivision inside one logical Folia tick.
Plugin-visible tick stays 20 TPS; no extra Bukkit entity ticks. Post-applyAllPatches.
---

--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapPhysicsSubsteps.java
+++ b/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapPhysicsSubsteps.java
@@ -0,0 +1,119 @@
+package io.papermc.paper.threadedregions;
+
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.MoverType;
+import net.minecraft.world.entity.boss.enderdragon.EnderDragon;
+import net.minecraft.world.entity.boss.wither.WitherBoss;
+import net.minecraft.world.entity.monster.warden.Warden;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.entity.projectile.Projectile;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * YaP physics sub-steps — higher-rate <strong>internal</strong> movement/combat integration
+ * inside one logical Folia region tick (plugin-visible tick stays 20 TPS).
+ *
+ * <p>Does not fire extra Bukkit events or advance game time. Knobs:
+ * <ul>
+ *   <li>{@code -Dyap.folia.physics-substeps=true}</li>
+ *   <li>{@code -Dyap.folia.physics-substep-count=4} (2–8)</li>
+ *   <li>{@code -Dyap.folia.physics-substep-min-move=0.02}</li>
+ * </ul>
+ */
+public final class YapPhysicsSubsteps {
+
+    private static final ThreadLocal<Integer> TRAVEL_FACTOR = new ThreadLocal<>();
+
+    private YapPhysicsSubsteps() {
+    }
+
+    public static boolean enabled() {
+        return Boolean.parseBoolean(System.getProperty("yap.folia.physics-substeps", "true"));
+    }
+
+    public static int count() {
+        final int raw = Integer.getInteger("yap.folia.physics-substep-count", 4);
+        return Math.max(2, Math.min(8, raw));
+    }
+
+    public static double minMove() {
+        try {
+            return Double.parseDouble(System.getProperty("yap.folia.physics-substep-min-move", "0.02"));
+        } catch (NumberFormatException e) {
+            return 0.02;
+        }
+    }
+
+    public static void enterTravelFactor(final int n) {
+        TRAVEL_FACTOR.set(n);
+    }
+
+    public static void leaveTravelFactor() {
+        TRAVEL_FACTOR.remove();
+    }
+
+    public static Integer travelFactor() {
+        return TRAVEL_FACTOR.get();
+    }
+
+    /** Scale full-tick gravity to per-substep gravity. */
+    public static double scaleGravity(final double gravity) {
+        final Integer n = TRAVEL_FACTOR.get();
+        return n == null || n <= 1 ? gravity : gravity / n;
+    }
+
+    /** Keep net friction ≈ one full tick when travel runs N times. */
+    public static float adjustFriction(final float friction) {
+        final Integer n = TRAVEL_FACTOR.get();
+        if (n == null || n <= 1) {
+            return friction;
+        }
+        if (friction <= 0.0F || friction >= 1.0F) {
+            return friction;
+        }
+        return (float) Math.pow(friction, 1.0 / n);
+    }
+
+    public static boolean eligibleTravel(final LivingEntity living) {
+        if (!enabled() || living.level().isClientSide()) {
+            return false;
+        }
+        if (living instanceof ServerPlayer || living instanceof Player) {
+            return true;
+        }
+        if (living instanceof EnderDragon || living instanceof WitherBoss || living instanceof Warden) {
+            return true;
+        }
+        // Combat / knockback window
+        if (living.hurtTime > 0 || living.invulnerableTime > 0) {
+            return true;
+        }
+        if (living.getLastHurtByMobTimestamp() > 0
+                && living.tickCount - living.getLastHurtByMobTimestamp() < 40) {
+            return true;
+        }
+        return living.isSprinting() || living.isFallFlying();
+    }
+
+    public static boolean eligibleMove(final Entity entity, final MoverType type, final Vec3 delta) {
+        if (!enabled() || entity.level().isClientSide() || type == MoverType.PISTON) {
+            return false;
+        }
+        final double min = minMove();
+        if (delta.lengthSqr() < min * min) {
+            return false;
+        }
+        if (entity instanceof ServerPlayer || entity instanceof Player) {
+            return true;
+        }
+        if (entity instanceof Projectile) {
+            return true;
+        }
+        if (entity instanceof LivingEntity living) {
+            return eligibleTravel(living);
+        }
+        return delta.lengthSqr() >= 1.0; // fast non-living (falling blocks, etc.)
+    }
+}

--- a/folia-server/src/minecraft/java/io/papermc/paper/threadedregions/YapMoveSubstep.java
