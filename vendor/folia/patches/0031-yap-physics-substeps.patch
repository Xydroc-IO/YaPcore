+package io.papermc.paper.threadedregions;
+
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.MoverType;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Subdivides {@link Entity#move} so high-speed / player / combat motion collides in N steps
+ * inside one logical tick (anti-tunnel + stabler knockback paths).
+ */
+public final class YapMoveSubstep {
+
+    private static final ThreadLocal<Boolean> REENTERING = ThreadLocal.withInitial(() -> Boolean.FALSE);
+
+    private YapMoveSubstep() {
+    }
+
+    /**
+     * @return true if this call fully handled the move (caller must return)
+     */
+    public static boolean trySubdivide(final Entity entity, final MoverType moverType, final Vec3 delta) {
+        if (Boolean.TRUE.equals(REENTERING.get())) {
+            return false;
+        }
+        // Travel multipass already issues N moves — do not nest move subdivision (N²).
+        if (YapPhysicsSubsteps.travelFactor() != null) {
+            return false;
+        }
+        if (!YapPhysicsSubsteps.eligibleMove(entity, moverType, delta)) {
+            return false;
+        }
+        final int n = YapPhysicsSubsteps.count();
+        if (n <= 1) {
+            return false;
+        }
+        final Vec3 step = delta.scale(1.0 / n);
+        if (step.equals(Vec3.ZERO)) {
+            return false;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("YaP move substep");
+        REENTERING.set(Boolean.TRUE);
+        try {
+            for (int i = 0; i < n; i++) {
+                entity.move(moverType, step);
+                if (!entity.isAlive() || entity.isRemoved()) {
+                    break;
+                }
+            }
+        } finally {
+            REENTERING.set(Boolean.FALSE);
+        }
+        return true;
+    }
+}

