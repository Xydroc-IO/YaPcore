+package io.papermc.paper.threadedregions;
+
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Runs {@link LivingEntity#travel} in N internal substeps with gravity/friction scaled so
+ * net motion ≈ one vanilla tick. Bukkit still sees one entity tick / one logical travel.
+ */
+public final class YapTravelSubstep {
+
+    private static final ThreadLocal<Boolean> REENTERING = ThreadLocal.withInitial(() -> Boolean.FALSE);
+
+    private YapTravelSubstep() {
+    }
+
+    /**
+     * @return true if this call fully handled travel (caller must return)
+     */
+    public static boolean tryMultiPass(final LivingEntity living, final Vec3 input) {
+        if (Boolean.TRUE.equals(REENTERING.get())) {
+            return false;
+        }
+        if (!YapPhysicsSubsteps.eligibleTravel(living)) {
+            return false;
+        }
+        final int n = YapPhysicsSubsteps.count();
+        if (n <= 1) {
+            return false;
+        }
+        ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("YaP travel substep");
+        final Vec3 scaled = input.scale(1.0 / n);
+        REENTERING.set(Boolean.TRUE);
+        YapPhysicsSubsteps.enterTravelFactor(n);
+        try {
+            for (int i = 0; i < n; i++) {
+                living.travel(scaled);
+                if (!living.isAlive() || living.isRemoved()) {
+                    break;
+                }
+            }
+        } finally {
+            YapPhysicsSubsteps.leaveTravelFactor();
+            REENTERING.set(Boolean.FALSE);
+        }
+        return true;
+    }
+}

