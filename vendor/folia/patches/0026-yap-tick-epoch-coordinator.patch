+        }
+    }
+
+    public static int activeRegionCount() {
+        return ACTIVE.size();
+    }
+
+    public static int epochPeerCount(final int worldId, final long epoch) {
+        final EpochState state = EPOCHS.get(new EpochKey(worldId, epoch));
+        return state == null ? 1 : Math.max(1, state.participants.size());
+    }
+
+    public static long wallEpoch() {
+        return System.nanoTime() / EPOCH_NS;
+    }
+
+    public static long waveTimeouts() {
+        return WAVE_TIMEOUTS.get();
+    }
+
+    public static int maxWaitMs() {
+        final int ms = Integer.getInteger("yap.folia.tick-wave-max-wait-ms", 2);
+        return Math.max(1, ms);
+    }
+
+    /**
+     * Mark arrival at {@code completedPhase} for {@code epoch}, then wait until the next phase
+     * is open (same-world epoch peers / single-region / timeout).
+     *
+     * @return true if the wait completed because the wave opened; false on soft timeout
+     */
+    public static boolean arriveAndAwaitNext(
+            final int worldId, final long epoch, final YapMicroPhase completedPhase) {
+        final YapMicroPhase next = completedPhase.next();
+        if (next == null) {
+            arrive(worldId, epoch, completedPhase);
+            return true;
+        }
+        arrive(worldId, epoch, completedPhase);
+        return awaitPhaseOpen(worldId, epoch, next);
+    }
+
+    public static void arrive(final int worldId, final long epoch, final YapMicroPhase phase) {
+        final Wave wave = wave(worldId, epoch, phase.index());
+        final int arrived = wave.arrivals.incrementAndGet();
+        maybeOpenNext(worldId, epoch, phase, arrived);
+    }
+
+    public static boolean awaitPhaseOpen(final int worldId, final long epoch, final YapMicroPhase phase) {
+        if (phase.index() == 0) {
+            return true;
+        }
+        if (epochPeerCount(worldId, epoch) <= 1) {
+            wave(worldId, epoch, phase.index()).open.set(true);
+            return true;
+        }
+        final Wave wave = wave(worldId, epoch, phase.index());
+        if (wave.open.get()) {
+            return true;
+        }
+        final Wave prior = WAVES.get(new WaveKey(worldId, epoch, phase.index() - 1));
+        final int peers = epochPeerCount(worldId, epoch);
+        final int priorArrivals = prior == null ? 0 : prior.arrivals.get();
+        if (priorArrivals < peers) {
+            // Sibling is still in an earlier phase (typical right after a split).
+            // 2ms cannot catch that hitch — do not stall or count a timeout.
+            wave.open.compareAndSet(false, true);
+            return true;
+        }
+        final long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(maxWaitMs());
+        while (!wave.open.get()) {
+            if (epochPeerCount(worldId, epoch) <= 1) {
+                wave.open.compareAndSet(false, true);
+                return true;
+            }
+            maybeOpenFromStalePeers(worldId, epoch, YapMicroPhase.byIndex(phase.index() - 1));
+            if (wave.open.get()) {
+                return true;
+            }
+            if (System.nanoTime() >= deadline) {
+                wave.open.compareAndSet(false, true);
+                if (epochPeerCount(worldId, epoch) > 1) {
+                    WAVE_TIMEOUTS.incrementAndGet();
+                    rateLimitedTimeoutLog(epoch, phase, peers);
+                }
+                return false;
+            }
+            Thread.onSpinWait();
+        }
+        return true;
+    }
+
+    private static void maybeOpenFromStalePeers(
+            final int worldId, final long epoch, final YapMicroPhase prior) {
+        final Wave priorWave = WAVES.get(new WaveKey(worldId, epoch, prior.index()));
+        if (priorWave == null) {
+            wave(worldId, epoch, prior.index() + 1).open.compareAndSet(false, true);
+            return;
+        }
+        maybeOpenNext(worldId, epoch, prior, priorWave.arrivals.get());
+    }
+
+    private static void maybeOpenNext(
+            final int worldId, final long epoch, final YapMicroPhase completed, final int arrived) {
+        final YapMicroPhase next = completed.next();
+        if (next == null) {
+            return;
+        }
+        if (arrived >= epochPeerCount(worldId, epoch)) {
+            wave(worldId, epoch, next.index()).open.compareAndSet(false, true);
+        }
+    }
+
+    private static Wave wave(final int worldId, final long epoch, final int phaseIndex) {
+        return WAVES.computeIfAbsent(new WaveKey(worldId, epoch, phaseIndex), k -> {
+            final Wave w = new Wave();
+            if (phaseIndex == 0) {
+                w.open.set(true);
+            }
+            return w;
+        });
+    }
+
+    private static void rateLimitedTimeoutLog(final long epoch, final YapMicroPhase phase, final int epochPeers) {
+        if (epochPeers <= 1) {
+            return;
+        }
+        final long now = System.nanoTime();
+        final long prev = LAST_TIMEOUT_LOG_NS.get();
+        if (now - prev < TimeUnit.SECONDS.toNanos(5L)) {
+            return;
+        }
+        if (!LAST_TIMEOUT_LOG_NS.compareAndSet(prev, now)) {
+            return;
+        }
+        LOGGER.debug(
+                "YaP aligned microtick soft-wave timeout epoch={} phase={} epochPeers={} activeRegions={} timeouts={}",
+                epoch,
+                phase,
+                epochPeers,
+                ACTIVE.size(),
+                WAVE_TIMEOUTS.get()
+        );
+    }
+
+    /** Drop old wave keys to avoid unbounded growth (best-effort). */
+    public static void scrubStaleWaves(final long currentEpoch) {
+        if ((currentEpoch & 31L) != 0L) {
+            return;
+        }
+        final long minEpoch = currentEpoch - 4L;
+        WAVES.keySet().removeIf(key -> key.epoch < minEpoch);
+        EPOCHS.keySet().removeIf(e -> e.epoch < minEpoch);
+    }
+
+    private record EpochKey(int worldId, long epoch) {
+    }
+
+    private record WaveKey(int worldId, long epoch, int phase) {
+    }
+
+    private static final class EpochState {
+        final ConcurrentHashMap.KeySetView<Long, Boolean> participants = ConcurrentHashMap.newKeySet();
+    }
+
+    private static final class Wave {
+        final AtomicInteger arrivals = new AtomicInteger();
+        final AtomicBoolean open = new AtomicBoolean(false);
+    }
+}
