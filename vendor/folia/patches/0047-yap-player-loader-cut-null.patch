         }
 
+        /** Registered corridor hole: do not load/generate/send. A player standing in the chunk stays pinned. */
+        private boolean skipCutHole(final int chunkX, final int chunkZ) {
+            return io.papermc.paper.threadedregions.YapRegionizerGap.blocksAddChunk(this.world, chunkX, chunkZ);
+        }
