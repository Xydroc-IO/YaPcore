From: YapLabs <folia@yaplabs.com>
Subject: [PATCH] YaP send play packets after the protocol switch

The global tick must not call syncUninterruptibly, but it also must
not send the login packet before the play encoder is installed. Chain
the configuration start and the spawn queue on that future. A missed
play keepalive was dropping bots during the sample. Not a longer timeout.
Post-applyAllPatches.
---

--- a/folia-server/src/minecraft/java/net/minecraft/network/Connection.java
+++ b/folia-server/src/minecraft/java/net/minecraft/network/Connection.java
@@ -337,10 +337,11 @@
         }
     }
 
-    private static void syncAfterConfigurationChange(final ChannelFuture future) {
+    private static void awaitProtocolChange(final io.netty.channel.ChannelFuture future) {
         // Login acknowledgement runs on the global tick. syncUninterruptibly
         // waits for the event loop to finish a pipeline task that cannot run
-        // while this thread is still inside the packet. That is the park.
+        // while this thread is still inside the packet. Callers on this thread
+        // must chain on the returned future instead of sending immediately.
         if (io.papermc.paper.threadedregions.RegionizedServer.isGlobalTickThread()) {
             return;
         }
@@ -355,7 +356,7 @@
         }
     }
 
-    public <T extends PacketListener> void setupInboundProtocol(final ProtocolInfo<T> protocol, final T packetListener) {
+    public <T extends PacketListener> io.netty.channel.ChannelFuture setupInboundProtocol(final ProtocolInfo<T> protocol, final T packetListener) {
         this.validateListener(protocol, packetListener);
         if (protocol.flow() != this.getReceiving()) {
             throw new IllegalStateException("Invalid inbound protocol: " + protocol.id());
@@ -370,10 +371,12 @@
             configMessage = configMessage.andThen(ctx -> ctx.pipeline().addAfter(HandlerNames.DECODER, HandlerNames.BUNDLER, newBundler));
         }
 
-        syncAfterConfigurationChange(this.channel.writeAndFlush(configMessage));
+        final io.netty.channel.ChannelFuture future = this.channel.writeAndFlush(configMessage);
+        awaitProtocolChange(future);
+        return future;
     }
 
-    public void setupOutboundProtocol(final ProtocolInfo<?> protocol) {
+    public io.netty.channel.ChannelFuture setupOutboundProtocol(final ProtocolInfo<?> protocol) {
         if (protocol.flow() != this.getSending()) {
             throw new IllegalStateException("Invalid outbound protocol: " + protocol.id());
         }
@@ -386,7 +389,9 @@
         }
 
