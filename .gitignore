# YaPcore — Git ignore (professional / GitHub-ready)
# Keep the published tree: source, operator docs, branding, run scripts, examples.
# Never commit build outputs, vendored Paper trees, live server state, or in-house lab work.

# =============================================================================
# Build / Gradle / JVM
# =============================================================================
.gradle/
**/build/
build/dist/
# Local release packages (gradle publishReleasesFolder) — never commit
/releases/
# Flat GitHub staging folder at repo root (symlinked from releases/upload)
/UPLOAD/
out/
bin/
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar
*.jmod
hs_err_pid*
replay_pid*
replay_*.log

# Root / module fat jars (also covered by *.jar)
/yapcore.jar
/yapcore-*.jar
yap-first-party/dev/bench-plugin/build/
# Gradle/output under any first-party module (defense in depth with **/build/)
yap-first-party/**/build/
scripts/bench/**/node_modules/

# =============================================================================
# Minecraft / Paper runtime caches (created next to the process cwd)
# =============================================================================
/libraries/
/versions/
/cache/
libraries/
versions/
cache/
crash-reports/
.paper/
*.marker
yap-paper-ready.marker

# Root leftover vanilla/Paper process files (live server cwd pollution)
/server.properties
/eula.txt
/ops.json
/whitelist.json
/banned-ips.json
/banned-players.json
/usercache.json
/bukkit.yml
/spigot.yml
/commands.yml
/help.yml
/permissions.yml
/wepif.yml

