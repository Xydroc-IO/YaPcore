*.schematic
*.schem
session.lock
uid.dat

# Embedded / wrap Paper kernels (full live trees)
paper-kernel/
game-kernel/

# Nested local server cwd (smoke/soak/deploy scratch — never publish)
/server/

# Folia live cwd — keep seeded yml / eula / config in git;
# ignore operator-generated state, jars, caches, worlds, rotated logs, and runtime server.properties overrides
folia-kernel/server.properties
!folia-kernel/server.properties.example
folia-kernel/logs/
folia-kernel/crash-reports/
folia-kernel/usercache.json
folia-kernel/ops.json
folia-kernel/banned-ips.json
folia-kernel/banned-players.json
