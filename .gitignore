folia-kernel/versions/
folia-kernel/.paper/
folia-kernel/world/
folia-kernel/world_nether/
folia-kernel/world_the_end/

# Downloaded / built server jars in lib/ (keep folder via .gitkeep)
lib/*
!lib/.gitkeep

# Vendored Paper checkout (clone via scripts/fetch-folia.sh for stock Folia bench)
vendor/paper/

# Folia vendor clone/build (Agent 1); keep lock + patches + README tracked
vendor/folia/work/
vendor/folia/*.tmp
# Multi-agent worktree lock (not UPSTREAM.lock)
vendor/folia/AGENT.lock

# Lab-only paperclip copies (never the product lib/yap-folia-26.2.jar)
lib/*-lab.jar
lib/yap-folia-*-lab.jar

# =============================================================================
# Bench runtime artifacts (scripts/bench/ stays tracked)
# =============================================================================
bench/
!scripts/bench/
!scripts/bench/**
# Re-ignore after !scripts/bench/** so a nested install cannot come back
scripts/bench/**/node_modules/
scripts/bench/bots/node_modules/

# Dev-only plugins and stress harness (not shipped)
yap-first-party/dev/*
# Cite / MSPT bench plugin is product-critical — keep sources tracked
!yap-first-party/dev/bench-plugin/
!yap-first-party/dev/bench-plugin/**
yap-first-party/dev/bench-plugin/build/
src/jcstress/

# Generated doc exports — Markdown under docs/ is the source of truth.
# Do not commit PDFs, HTML print intermediates, or office dumps (looks unprofessional).
docs/pdf/**
!docs/pdf/
!docs/pdf/.gitkeep
!docs/pdf/README.md
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.odt
*.ods
*.odp

